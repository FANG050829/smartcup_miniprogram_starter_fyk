.bind-card {
    margin: 0 32rpx 24rpx;
    padding: 32rpx;
    background: #FFFFFF;
    border-radius: 36rpx;
    box-shadow: 0 20rpx 56rpx rgba(13, 70, 92, 0.07),
    0 8rpx 20rpx rgba(13, 70, 92, 0.04),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.96);
}

.bind-area {
    display: flex;
    gap: 16rpx;
    margin-bottom: 8rpx;
}

.bind-input {
    flex: 1;
    height: 88rpx;
    padding: 0 28rpx;
    background: #F7F9FA;
    border-radius: 24rpx;
    border: 1rpx solid rgba(17, 17, 17, 0.05);
    font-size: 28rpx;
    color: #111111;
    font-variant-numeric: tabular-nums;
    letter-spacing: 1rpx;
    box-sizing: border-box;
    transition: border-color 0.15s ease, background 0.15s ease;
}

.bind-input:focus {
    border-color: rgba(15, 142, 168, 0.4);
    background: #FFFFFF;
}

.bind-placeholder {
    color: #b8c8d0;
    letter-spacing: 0.5rpx;
}

.bind-btn {
    height: 88rpx;
    padding: 0 40rpx;
    background: #0f8ea8;
    border-radius: 24rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8rpx 20rpx rgba(15, 142, 168, 0.28),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.2);
    transition: transform 0.16s ease, opacity 0.16s ease;
    box-sizing: border-box;
}

.bind-btn.disabled {
    opacity: 0.7;
}

.bind-btn-text {
    font-size: 28rpx;
    color: #FFFFFF;
    font-weight: 600;
    letter-spacing: 2rpx;
}

.scan-row {
    display: flex;
    align-items: center;
    padding: 28rpx 0 4rpx;
    position: relative;
    transition: opacity 0.16s ease;
}

.scan-row::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1rpx;
    background: rgba(17, 17, 17, 0.05);
}

.scan-row-title {
    flex: 1;
    font-size: 28rpx;
    color: #111111;
    font-weight: 500;
    letter-spacing: 0.5rpx;
    margin-left: 20rpx;
}

.bind-scan-icon {
    width: 36rpx;
    height: 36rpx;
    flex-shrink: 0;
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
    background-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%20fill='none'%20stroke='%230d3b4e'%20stroke-width='1.8'%20stroke-linecap='round'%20stroke-linejoin='round'%3E%3Cpath%20d='M3%207V5a2%202%200%200%201%202-2h2'/%3E%3Cpath%20d='M17%203h2a2%202%200%200%201%202%202v2'/%3E%3Cpath%20d='M21%2017v2a2%202%200%200%201-2%202h-2'/%3E%3Cpath%20d='M7%2021H5a2%202%200%200%201-2-2v-2'/%3E%3Cline%20x1='7'%20x2='17'%20y1='12'%20y2='12'/%3E%3C/svg%3E");
}

.device-card {
    margin: 0 32rpx 24rpx;
    padding: 12rpx 32rpx 20rpx;
    background: #FFFFFF;
    border-radius: 36rpx;
    box-shadow: 0 20rpx 56rpx rgba(13, 70, 92, 0.07),
    0 8rpx 20rpx rgba(13, 70, 92, 0.04),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.96);
}

.device-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16rpx 0 20rpx;
    border-bottom: 1rpx solid rgba(17, 17, 17, 0.05);
    margin-bottom: 4rpx;
}

.device-card-title {
    font-size: 24rpx;
    color: #6b7a85;
    font-weight: 500;
    letter-spacing: 0.5rpx;
}

.device-card-count {
    font-size: 24rpx;
    color: #0f8ea8;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    letter-spacing: 0.5rpx;
}

.device-row {
    display: flex;
    align-items: center;
    padding: 28rpx 0;
    position: relative;
}

.device-row::after {
    content: "";
    position: absolute;
    left: 56rpx;
    right: 0;
    bottom: 0;
    height: 1rpx;
    background: rgba(17, 17, 17, 0.05);
}

.device-row:last-child::after {
    display: none;
}

.device-info {
    display: flex;
    flex-direction: column;
    gap: 6rpx;
    flex: 1;
    min-width: 0;
    margin-left: 20rpx;
}

.device-name {
    font-size: 30rpx;
    color: #111111;
    font-weight: 500;
    letter-spacing: 0.5rpx;
    line-height: 1.2;
}

.device-id {
    font-size: 22rpx;
    color: #8b9ba6;
    font-variant-numeric: tabular-nums;
    letter-spacing: 1rpx;
    line-height: 1.2;
}

.device-remove {
    padding: 10rpx 18rpx;
    margin-left: 16rpx;
    flex-shrink: 0;
    border-radius: 999rpx;
    background: rgba(217, 96, 88, 0.08);
    transition: opacity 0.15s ease;
}

.remove-text {
    font-size: 22rpx;
    color: #d96058;
    font-weight: 500;
    letter-spacing: 1rpx;
}

.logout-btn {
    margin: 8rpx 32rpx 0;
    padding: 32rpx 0;
    background: #FFFFFF;
    border-radius: 36rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.16s ease, opacity 0.16s ease;
    box-shadow: 0 12rpx 32rpx rgba(13, 70, 92, 0.05),
    0 4rpx 12rpx rgba(13, 70, 92, 0.03),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.96);
}

.logout-text {
    font-size: 30rpx;
    color: #d96058;
    font-weight: 600;
    letter-spacing: 2rpx;
}
