page {
    font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
    -webkit-font-smoothing: antialiased;
    color: #111111;
    background: #F7F9FA;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.5rpx;
}

.page {
    min-height: 100vh;
    background: #F7F9FA;
    animation: none;
    will-change: auto;
}

.scroll {
    height: 100vh;
    height: calc(100vh - 16rpx);
    box-sizing: border-box;
    background: #F7F9FA;
}

.scroll-body {
    min-height: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
}

.bottom-fill {
    flex: 1 1 auto;
    min-height: 24rpx;
    margin-bottom: 128rpx;
    margin-bottom: calc(128rpx + env(safe-area-inset-bottom));
    margin-bottom: calc(128rpx + constant(safe-area-inset-bottom));
}

.anim-profile-slide-in {
    animation: profileSlideIn 420ms cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
    will-change: opacity, transform;
}

@keyframes profileSlideIn {
    0% {
        opacity: 0;
        transform: translateX(40rpx);
    }

    100% {
        opacity: 1;
        transform: translateX(0);
    }
}

.anim-grid-item {
    animation: gridItemIn 380ms cubic-bezier(0.34, 1.2, 0.64, 1) both;
    will-change: opacity, transform;
}

@keyframes gridItemIn {
    0% {
        opacity: 0;
        transform: translateY(28rpx) scale(0.9);
    }

    100% {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

.anim-list-slide-in {
    animation: listSlideIn 400ms cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
    will-change: opacity, transform;
}

@keyframes listSlideIn {
    0% {
        opacity: 0;
        transform: translateY(20rpx);
    }

    100% {
        opacity: 1;
        transform: translateY(0);
    }
}

@media (prefers-reduced-motion: reduce) {
    .anim-profile-slide-in, .anim-grid-item, .anim-list-slide-in {
        animation: none;
        will-change: auto;
    }
}

.gridItemHover {
    transform: scale(0.96);
    opacity: 0.7;
    transition: transform 0.18s ease, opacity 0.18s ease;
}

.listRowHover {
    opacity: 0.55;
    transition: opacity 0.18s ease;
}

.bindBtnHover {
    transform: scale(0.97);
    opacity: 0.92;
    transition: transform 0.16s ease, opacity 0.16s ease;
}

.scanHover {
    opacity: 0.55;
    transition: opacity 0.16s ease;
}

.removeHover {
    opacity: 0.45;
    transition: opacity 0.15s ease;
}

.logoutBtnHover {
    transform: scale(0.99);
    opacity: 0.8;
    transition: transform 0.16s ease, opacity 0.16s ease;
}

.topbar {
    height: 16rpx;
}

.profile-card {
    margin: 16rpx 32rpx 24rpx;
    padding: 64rpx 32rpx 48rpx;
    background: #FFFFFF;
    border-radius: 36rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow: 0 20rpx 56rpx rgba(13, 70, 92, 0.07),
    0 8rpx 20rpx rgba(13, 70, 92, 0.04),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.96);
}

.profile-avatar {
    width: 128rpx;
    height: 128rpx;
    border-radius: 50%;
    background: linear-gradient(180deg, #FFFFFF, #F7F9FA);
    border: 1rpx solid #eef1f3;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    box-shadow: 0 8rpx 24rpx rgba(13, 70, 92, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 1);
    margin-bottom: 28rpx;
}

.profile-avatar-icon {
    width: 60rpx;
    height: 60rpx;
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
    background-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%20fill='none'%20stroke='%230d3b4e'%20stroke-width='1.5'%20stroke-linecap='round'%20stroke-linejoin='round'%3E%3Ccircle%20cx='12'%20cy='8'%20r='4'/%3E%3Cpath%20d='M5%2021c0-3.866%203.134-7%207-7s7%203.134%207%207'/%3E%3C/svg%3E");
}

.profile-name {
    font-size: 40rpx;
    color: #111111;
    font-weight: 600;
    letter-spacing: 1rpx;
    line-height: 1.2;
    margin-bottom: 10rpx;
}

.profile-sub {
    font-size: 24rpx;
    color: #8b9ba6;
    font-weight: 400;
    letter-spacing: 0.5rpx;
    line-height: 1.4;
    margin-bottom: 20rpx;
    max-width: 80%;
    text-align: center;
    word-break: break-all;
}

.profile-status {
    display: flex;
    align-items: center;
    gap: 12rpx;
    padding: 8rpx 20rpx;
    background: rgba(247, 249, 250, 0.8);
    border-radius: 999rpx;
    border: 1rpx solid rgba(17, 17, 17, 0.04);
}

.status-dot {
    width: 10rpx;
    height: 10rpx;
    border-radius: 50%;
    flex-shrink: 0;
}

.status-dot.on {
    background: #0f8ea8;
    box-shadow: 0 0 0 4rpx rgba(15, 142, 168, 0.16);
}

.status-dot.off {
    background: #c4ccd2;
    box-shadow: none;
}

.status-text {
    font-size: 22rpx;
    color: #6b7a85;
    letter-spacing: 0.5rpx;
    line-height: 1;
    font-weight: 500;
}

.grid {
    margin: 0 32rpx 24rpx;
    padding: 36rpx 0;
    background: #FFFFFF;
    border-radius: 36rpx;
    display: flex;
    align-items: stretch;
    box-shadow: 0 20rpx 56rpx rgba(13, 70, 92, 0.07),
    0 8rpx 20rpx rgba(13, 70, 92, 0.04),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.96);
}

.grid-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 12rpx 0;
    transition: transform 0.18s ease, opacity 0.18s ease;
    position: relative;
    gap: 8rpx;
}

.grid-item + .grid-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 25%;
    bottom: 25%;
    width: 1rpx;
    background: rgba(17, 17, 17, 0.05);
}

.grid-icon {
    width: 40rpx;
    height: 40rpx;
    margin-bottom: 4rpx;
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
}

.grid-item-title {
    font-size: 28rpx;
    color: #111111;
    font-weight: 600;
    letter-spacing: 0.5rpx;
    line-height: 1.3;
}

.grid-item-sub {
    font-size: 20rpx;
    color: #9aa8b3;
    font-weight: 400;
    letter-spacing: 0.5rpx;
    line-height: 1.3;
}

.list-card {
    margin: 0 32rpx 24rpx;
    background: #FFFFFF;
    border-radius: 36rpx;
    padding: 8rpx 36rpx;
    box-shadow: 0 20rpx 56rpx rgba(13, 70, 92, 0.07),
    0 8rpx 20rpx rgba(13, 70, 92, 0.04),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.96);
}

.list-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 32rpx 0;
    position: relative;
    transition: opacity 0.18s ease;
}

.list-row::after {
    content: "";
    position: absolute;
    left: 56rpx;
    right: 0;
    bottom: 0;
    height: 1rpx;
    background: rgba(17, 17, 17, 0.05);
}

.list-row-last::after {
    display: none;
}

.list-icon {
    width: 36rpx;
    height: 36rpx;
    flex-shrink: 0;
    margin-right: 20rpx;
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
}

.list-row-title {
    flex: 1;
    font-size: 30rpx;
    color: #111111;
    letter-spacing: 0.5rpx;
    font-weight: 500;
    line-height: 1.4;
}

.list-row-arrow {
    width: 16rpx;
    height: 16rpx;
    border-top: 2rpx solid #b8c8d0;
    border-right: 2rpx solid #b8c8d0;
    transform: rotate(45deg);
    flex-shrink: 0;
    margin-left: 12rpx;
}

