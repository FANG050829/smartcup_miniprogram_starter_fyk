/* 反AI打磨约定（本次 pass）：
   1) 无渐变/无光斑/无发光：页面平涂继承全局 #F7F9FA，卡片平涂白 + 发丝描边。
   2) 两级圆角：卡片 20rpx，内控件 12rpx，不再出现 999rpx 大胶囊（主按钮 16rpx）。
   3) 字重分层 700/500/400，数字 tabular-nums。
   4) 主按钮扁平 teal，无彩色发光；超时态不换红色按钮，由状态点/水位条/状态行表达。
   5) 动效仅两处：水位条 width 过渡、超时状态点脉冲；prefers-reduced-motion 全降级。
   6) 命名统一「久未喝水提醒」，与入口、弹窗一致。 */

.page {
    --accent: #0f8ea8;
    --accent-deep: #0b6e86;
    --ink: #102a43;
    --muted: #5a7084;
    --faint: #5f7589;
    --hairline: rgba(16, 42, 67, 0.08);
    --ok: #1f9e6b;
    --ok-ink: #0e7a5f;
    --alert: #c14f43;
    --alert-ink: #a63e33;
    min-height: 100vh;
    box-sizing: border-box;
    padding: 24rpx 24rpx calc(env(safe-area-inset-bottom) + 48rpx);
}

.press {
    transform: translateY(2rpx) scale(0.99);
    opacity: 0.94;
}

/* ---- 间隔水钟（hero） ---- */

.timerCard {
    background: #ffffff;
    border: 1px solid rgba(16, 42, 67, 0.06);
    border-radius: 20rpx;
    padding: 30rpx 28rpx 32rpx;
}

.timerCard.tone--alert {
    border-color: rgba(193, 79, 67, 0.22);
    background: #fffcfb;
}

.timerHead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16rpx;
}

.timerKicker {
    font-size: 22rpx;
    font-weight: 600;
    color: var(--muted);
}

.stateLine {
    display: flex;
    align-items: center;
    gap: 10rpx;
    font-size: 22rpx;
    font-weight: 700;
}

.stateDot {
    width: 12rpx;
    height: 12rpx;
    border-radius: 50%;
}

/* 状态读数：色随 stateTone（未启用/未开始一律灰，避免绿色误读为监测中） */

.st--ok {
    color: var(--ok-ink);
}

.st--ok .stateDot {
    background: var(--ok);
}

.st--alert {
    color: var(--alert-ink);
}

.st--alert .stateDot {
    background: var(--alert);
    animation: pulseDot 1.4s ease-in-out infinite;
}

.st--off,
.st--empty {
    color: var(--muted);
}

.st--off .stateDot,
.st--empty .stateDot {
    background: #97a8b6;
}

.timerReadout {
    display: block;
    margin-top: 10rpx;
    font-size: 56rpx;
    line-height: 1.15;
    font-weight: 700;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
}

/* 水位条：从「上次喝水」流向「N 小时提醒线」 */

.timerBar {
    position: relative;
    margin-top: 26rpx;
    height: 16rpx;
    border-radius: 999rpx;
    background-color: rgba(15, 142, 168, 0.1);
    /* 发丝小刻度：每 12.5% 一道，与主刻度 25/50/75 对齐 */
    background-image: repeating-linear-gradient(
        to right,
        transparent 0,
        transparent calc(12.5% - 1px),
        rgba(255, 255, 255, 0.75) calc(12.5% - 1px),
        rgba(255, 255, 255, 0.75) 12.5%
    );
    overflow: hidden;
}

.timerFill {
    position: relative;
    height: 100%;
    border-radius: 999rpx;
    background: var(--accent);
    transition: width 600ms cubic-bezier(0.22, 0.61, 0.36, 1);
}

.tone--alert .timerFill {
    background: var(--alert);
}

/* 液面高光端线 */

.timerFill::after {
    content: "";
    position: absolute;
    right: 0;
    top: 0;
    width: 2rpx;
    height: 100%;
    background: rgba(255, 255, 255, 0.7);
}

.timerTick {
    position: absolute;
    top: 0;
    width: 1px;
    height: 100%;
    background: rgba(255, 255, 255, 0.9);
}

.timerTick.t1 {
    left: 25%;
}

.timerTick.t2 {
    left: 50%;
}

.timerTick.t3 {
    left: 75%;
}

.timerScale {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 8rpx;
}

.timerScaleTxt {
    font-size: 20rpx;
    font-weight: 500;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
}

.timerNote {
    display: block;
    margin-top: 22rpx;
    font-size: 22rpx;
    font-weight: 500;
    color: var(--muted);
}

.note--ok {
    color: var(--ok-ink);
}

.note--alert {
    color: var(--alert-ink);
    font-weight: 600;
}

.primaryBtn {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 88rpx;
    margin-top: 26rpx;
    border-radius: 16rpx;
    background: var(--accent);
}

.primaryBtnText {
    font-size: 26rpx;
    font-weight: 700;
    color: #ffffff;
}

/* ---- 提醒设置 ---- */

.sectionKicker {
    margin: 32rpx 6rpx 14rpx;
    font-size: 20rpx;
    font-weight: 600;
    letter-spacing: 1rpx;
    color: var(--muted);
}

.panel {
    background: #ffffff;
    border: 1px solid rgba(16, 42, 67, 0.06);
    border-radius: 20rpx;
    padding: 8rpx 24rpx;
}

.row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16rpx;
    padding: 24rpx 0;
}

/* 可点行：负边距内缩出圆角按压底 */

.rowTapWrap {
    margin: 0 -16rpx;
    border-radius: 12rpx;
}

.rowTapWrap .row {
    padding-left: 16rpx;
    padding-right: 16rpx;
}

.rowHover {
    background: rgba(15, 142, 168, 0.05);
}

.rowInfo {
    flex: 1;
    min-width: 0;
}

.rowLabel {
    display: block;
    font-size: 26rpx;
    font-weight: 600;
    color: var(--ink);
}

.rowDesc {
    display: block;
    margin-top: 4rpx;
    font-size: 20rpx;
    font-weight: 400;
    line-height: 1.4;
    color: var(--muted);
}

.hairline {
    height: 1px;
    background: var(--hairline);
}

.hairlineInset {
    margin: 0 16rpx;
}

.stepper {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 8rpx;
    padding: 10rpx 18rpx;
    border: 1px solid rgba(16, 42, 67, 0.1);
    border-radius: 12rpx;
    background: #ffffff;
}

.stepperValue {
    font-size: 24rpx;
    font-weight: 600;
    color: var(--accent-deep);
    font-variant-numeric: tabular-nums;
}

.chevRight {
    width: 12rpx;
    height: 12rpx;
    border-right: 3rpx solid rgba(15, 142, 168, 0.8);
    border-top: 3rpx solid rgba(15, 142, 168, 0.8);
    transform: rotate(45deg);
    margin-left: 2rpx;
}

.methodBlock {
    padding: 24rpx 0 12rpx;
}

.radioGroup {
    margin-top: 8rpx;
}

.radioRow {
    display: flex;
    align-items: center;
    gap: 16rpx;
    padding: 20rpx 16rpx;
    margin: 0 -16rpx;
    border-radius: 12rpx;
}

.radioContent {
    flex: 1;
    min-width: 0;
}

.radioLabel {
    display: block;
    font-size: 26rpx;
    font-weight: 600;
    color: var(--ink);
}

.radioDesc {
    display: block;
    margin-top: 4rpx;
    font-size: 20rpx;
    font-weight: 400;
    color: var(--muted);
}

/* ---- 说明（发丝线脚注，不做盒子） ---- */

.notes {
    margin: 28rpx 6rpx 0;
    padding-top: 20rpx;
    border-top: 1px solid var(--hairline);
    display: flex;
    flex-direction: column;
    gap: 8rpx;
}

.noteLine {
    font-size: 20rpx;
    font-weight: 400;
    line-height: 1.6;
    color: var(--faint);
}

@keyframes pulseDot {

    0%,
    100% {
        opacity: 1;
    }

    50% {
        opacity: 0.35;
    }
}

@media (prefers-reduced-motion: reduce) {

    .tone--alert .stateDot {
        animation: none;
    }

    .timerFill {
        transition: none;
    }
}
