.page {
    position: relative;
    min-height: 100vh;
    background: var(--bg);
    color: var(--fg);
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "PingFang SC",
    "Helvetica Neue", "Microsoft YaHei", system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.5rpx;
    animation: none;
    will-change: auto;
}

.pageScroll {
    position: relative;
    z-index: 1;
    height: 100vh;
    padding: 24rpx 24rpx 160rpx;
    padding-bottom: calc(160rpx + constant(safe-area-inset-bottom));
    padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
    box-sizing: border-box;
}

/* prefers-reduced-motion：停用本页全部无限循环动画
 * （orb 浮动 ×2 / 大数字脉冲 / 状态呼吸 / 空态呼吸 / 虚线环旋转），
 * 并定格到首帧姿态作静态兜底 */
@media (prefers-reduced-motion: reduce) {
    .overviewOrb.orb1,
    .overviewOrb.orb2,
    .overviewAmount,
    .overviewStatus,
    .emptyIcon,
    .emptyIconRing {
        animation: none;
        will-change: auto;
    }

    .overviewOrb.orb1 {
        opacity: 0.7;
        transform: none;
    }

    .overviewOrb.orb2 {
        opacity: 0.6;
        transform: none;
    }
}

.overviewCard {
    background: var(--card);
    border: 1rpx solid var(--line);
    border-radius: var(--r);
    padding: 48rpx 44rpx;
    color: var(--fg);
    margin-bottom: 36rpx;
    position: relative;
    overflow: hidden;
    box-shadow: var(--shadow);
}

.overviewBg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
}

.overviewOrb {
    position: absolute;
    border-radius: 50%;
    filter: blur(48rpx);
}

.overviewOrb.orb1 {
    width: 320rpx;
    height: 320rpx;
    background: radial-gradient(circle, rgba(127, 190, 216, 0.22) 0%, transparent 70%);
    top: -100rpx;
    right: -80rpx;
    animation: orbFloat1 12s ease-in-out infinite;
}

.overviewOrb.orb2 {
    width: 240rpx;
    height: 240rpx;
    background: radial-gradient(circle, rgba(31, 110, 140, 0.18) 0%, transparent 70%);
    bottom: -80rpx;
    left: -60rpx;
    animation: orbFloat2 16s ease-in-out infinite;
}

@keyframes orbFloat1 {
    0%, 100% {
        transform: translate(0, 0) scale(1);
        opacity: 0.7;
    }

    50% {
        transform: translate(-40rpx, 30rpx) scale(1.25);
        opacity: 1;
    }
}

@keyframes orbFloat2 {
    0%, 100% {
        transform: translate(0, 0) scale(1);
        opacity: 0.6;
    }

    50% {
        transform: translate(30rpx, -25rpx) scale(1.2);
        opacity: 0.9;
    }
}

.overviewLabel {
    font-size: 22rpx;
    color: var(--muted);
    font-weight: 500;
    letter-spacing: 2rpx;
    display: block;
    margin-bottom: 24rpx;
    position: relative;
    z-index: 1;
}

.overviewMain {
    display: flex;
    align-items: baseline;
    gap: 8rpx;
    margin-bottom: 14rpx;
    position: relative;
    z-index: 1;
}

.overviewAmount {
    font-size: 112rpx;
    font-weight: 700;
    letter-spacing: -4rpx;
    line-height: 1;
    color: var(--teal);
}

.overviewUnit {
    font-size: 28rpx;
    color: var(--muted);
    font-weight: 500;
    letter-spacing: 1rpx;
}

.overviewGoal {
    font-size: 24rpx;
    color: var(--muted);
    margin-bottom: 36rpx;
    letter-spacing: 0.5rpx;
    position: relative;
    z-index: 1;
}

.overviewProgress {
    height: 10rpx;
    background: rgba(31, 110, 140, 0.08);
    border-radius: 999rpx;
    overflow: hidden;
    margin-bottom: 28rpx;
    position: relative;
    z-index: 1;
}

.overviewFill {
    height: 100%;
    background: var(--teal-soft);
    border-radius: 999rpx;
    /* 有意用 width 过渡：条高仅 10rpx 级、单次状态过渡；scaleX 会压扁胶囊圆头 */
    transition: width 1s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.overviewFooter {
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
    z-index: 1;
}

.overviewPercent {
    font-size: 28rpx;
    color: var(--fg);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.5rpx;
}

.overviewStatus {
    font-size: 22rpx;
    padding: 10rpx 22rpx;
    background: rgba(127, 190, 216, 0.16);
    border: 1rpx solid rgba(127, 190, 216, 0.32);
    border-radius: 999rpx;
    font-weight: 500;
    letter-spacing: 1rpx;
    color: var(--teal-deep);
    animation: statusBreathe 3s ease-in-out infinite;
}

@keyframes statusBreathe {
    0%, 100% {
        box-shadow: 0 0 0 0 rgba(127, 190, 216, 0);
    }

    50% {
        box-shadow: 0 0 0 8rpx rgba(127, 190, 216, 0.12);
    }
}

.section {
    margin-bottom: 36rpx;
}

.sectionHeader {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 28rpx;
}

.sectionTitle {
    font-size: 38rpx;
    font-weight: 700;
    letter-spacing: -0.5rpx;
    color: var(--fg);
}

.sectionAction {
    font-size: 26rpx;
    color: #ffffff;
    font-weight: 500;
    padding: 14rpx 30rpx;
    background: var(--teal);
    border-radius: 999rpx;
    transition: all 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
    letter-spacing: 1rpx;
    box-shadow: 0 8rpx 20rpx rgba(15, 142, 168, 0.28);
}

.reminderList {
    display: flex;
    flex-direction: column;
    gap: 16rpx;
}

.reminderItem {
    background: var(--card);
    border: 1rpx solid var(--line);
    border-radius: var(--r);
    padding: 32rpx;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    box-shadow: var(--shadow);
}

.reminderItem::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4rpx;
    height: 100%;
    background: var(--teal-soft);
    opacity: 0;
}

.reminderItem.isDone {
    background: var(--bg);
}

.reminderItem.isDone::before {
    opacity: 0.4;
}

.reminderLeft {
    display: flex;
    align-items: center;
    gap: 24rpx;
}

.reminderTimeWrapper {
    display: flex;
    flex-direction: column;
    gap: 8rpx;
}

.reminderTime {
    font-size: 50rpx;
    font-weight: 700;
    letter-spacing: -1.5rpx;
    font-variant-numeric: tabular-nums;
    color: var(--fg);
}

.reminderRepeat {
    font-size: 24rpx;
    color: var(--muted);
    letter-spacing: 0.5rpx;
}

.reminderBadge {
    font-size: 20rpx;
    padding: 8rpx 18rpx;
    border-radius: 999rpx;
    font-weight: 500;
    letter-spacing: 1rpx;
    transition: all 0.3s ease;
}

.reminderBadge.upcoming {
    background: rgba(31, 110, 140, 0.06);
    color: var(--muted);
}

.reminderBadge.completed {
    background: rgba(15, 142, 168, 0.1);
    color: var(--teal-deep);
    border: 1rpx solid rgba(15, 142, 168, 0.2);
}

.reminderActions {
    display: flex;
    gap: 12rpx;
}

.reminderBtn {
    min-width: 96rpx;
    height: 64rpx;
    padding: 0 24rpx;
    border-radius: 999rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.reminderBtn.edit {
    background: rgba(15, 142, 168, 0.08);
}

.reminderBtn.delete {
    background: rgba(239, 68, 68, 0.08);
}

.reminderBtnText {
    font-size: 24rpx;
    line-height: 1;
    font-weight: 500;
    letter-spacing: 1rpx;
}

.reminderBtn.edit .reminderBtnText {
    color: var(--teal-deep);
}

.reminderBtn.delete .reminderBtnText {
    color: var(--bad-ink);
}

.emptyState {
    text-align: center;
    padding: 100rpx 60rpx;
    background: var(--card);
    border-radius: var(--r);
    border: 1rpx dashed var(--line);
}

.emptyIcon {
    width: 140rpx;
    height: 140rpx;
    background: rgba(15, 142, 168, 0.06);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 32rpx;
    position: relative;
    animation: emptyBreathe 3s ease-in-out infinite;
}

@keyframes emptyBreathe {
    0%, 100% {
        transform: scale(1);
        box-shadow: 0 0 0 0 rgba(15, 142, 168, 0);
    }

    50% {
        transform: scale(1.05);
        box-shadow: 0 0 0 16rpx rgba(15, 142, 168, 0.04);
    }
}

.emptyIconRing {
    position: absolute;
    inset: -8rpx;
    border-radius: 50%;
    border: 2rpx dashed rgba(15, 142, 168, 0.3);
    animation: rotate 20s linear infinite;
}

@keyframes rotate {
    from {
        transform: rotate(0deg);
    }

    to {
        transform: rotate(360deg);
    }
}

.emptyIconText {
    font-size: 56rpx;
    color: var(--teal-soft);
    font-weight: 300;
    line-height: 1;
    position: relative;
    z-index: 1;
}

.emptyText {
    font-size: 28rpx;
    color: var(--muted);
    display: block;
    margin-bottom: 36rpx;
    letter-spacing: 0.5rpx;
}

.emptyBtn {
    display: inline-block;
    font-size: 26rpx;
    font-weight: 500;
    color: #ffffff;
    background: var(--teal);
    padding: 22rpx 52rpx;
    border-radius: 999rpx;
    transition: all 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
    letter-spacing: 1rpx;
    box-shadow: 0 12rpx 28rpx rgba(15, 142, 168, 0.28);
}

.editRow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28rpx 0;
    border-bottom: 1rpx solid var(--line);
    transition: background 0.2s ease;
}

.editRow:last-child {
    border-bottom: none;
}

.editLabel {
    font-size: 28rpx;
    color: var(--muted);
    letter-spacing: 0.5rpx;
}

.editValue {
    font-size: 28rpx;
    font-weight: 500;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.5rpx;
}

.editValueRow {
    display: flex;
    align-items: center;
    gap: 12rpx;
}

.editArrow {
    color: var(--muted);
    font-size: 32rpx;
    font-weight: 300;
}

.repeatMenu {
    margin-top: 16rpx;
    background: rgba(31, 110, 140, 0.03);
    border-radius: var(--r);
    padding: 8rpx;
    animation: menuIn 0.3s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

@keyframes menuIn {
    from {
        opacity: 0;
        transform: translateY(-8rpx);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.repeatOption {
    /* 小控件保留小圆角（14rpx），不收敛到全局 --r */
    border-radius: 14rpx;
    font-size: 28rpx;
    color: var(--fg);
    transition: all 0.25s cubic-bezier(0.22, 0.61, 0.36, 1);
    letter-spacing: 0.5rpx;
}

.repeatOption.on {
    background: var(--teal);
    color: #ffffff;
    font-weight: 500;
    box-shadow: 0 8rpx 20rpx rgba(15, 142, 168, 0.28);
}

.dateRow {
    display: flex;
    align-items: center;
    gap: 20rpx;
    padding: 28rpx 0;
    border-bottom: 1rpx solid var(--line);
}

.dateSummary {
    flex: 1;
    font-size: 28rpx;
    color: var(--fg);
    letter-spacing: 0.5rpx;
}

.dateBtn {
    font-size: 24rpx;
    color: #ffffff;
    padding: 14rpx 28rpx;
    /* 小控件保留小圆角（14rpx），不收敛到全局 --r */
    border-radius: 14rpx;
    background: var(--teal);
    font-weight: 500;
    transition: all 0.2s cubic-bezier(0.22, 0.61, 0.36, 1);
    letter-spacing: 0.5rpx;
}

.dateDropdown {
    margin-top: 16rpx;
}

.dateChips {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
    padding: 20rpx 0;
}

.dateChip {
    font-size: 22rpx;
    padding: 12rpx 24rpx;
    border-radius: 999rpx;
    background: var(--teal);
    color: #ffffff;
    letter-spacing: 0.5rpx;
    animation: chipIn 0.25s cubic-bezier(0.22, 0.61, 0.36, 1) both;
    box-shadow: 0 4rpx 12rpx rgba(15, 142, 168, 0.2);
}

@keyframes chipIn {
    from {
        opacity: 0;
        transform: scale(0.8);
    }

    to {
        opacity: 1;
        transform: scale(1);
    }
}

.dateEmpty {
    font-size: 24rpx;
    color: var(--muted);
    padding: 20rpx 0;
    letter-spacing: 0.5rpx;
}

.dateEditRow, .calActions {
    display: flex;
    gap: 16rpx;
    margin-top: 20rpx;
}

.dateEditBtn {
    flex: 1;
    text-align: center;
    font-size: 26rpx;
    padding: 20rpx 0;
    /* 小控件保留小圆角（14rpx），不收敛到全局 --r */
    border-radius: 14rpx;
    background: rgba(31, 110, 140, 0.05);
    color: var(--fg);
    font-weight: 500;
    transition: all 0.2s cubic-bezier(0.22, 0.61, 0.36, 1);
    letter-spacing: 0.5rpx;
}

.dateEditBtn.primary {
    background: var(--teal);
    color: #ffffff;
    box-shadow: 0 6rpx 16rpx rgba(15, 142, 168, 0.24);
}

.calendarPanel {
    margin-top: 24rpx;
    background: rgba(31, 110, 140, 0.03);
    border-radius: var(--r);
    padding: 28rpx;
    box-sizing: border-box;
    animation: calendarIn 0.35s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

@keyframes calendarIn {
    from {
        opacity: 0;
        transform: translateY(-12rpx);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.calHeader {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24rpx;
}

.calNav {
    width: 68rpx;
    height: 68rpx;
    border-radius: 50%;
    background: #ffffff;
    text-align: center;
    line-height: 68rpx;
    font-size: 28rpx;
    color: var(--muted);
    transition: all 0.2s cubic-bezier(0.22, 0.61, 0.36, 1);
    border: 1rpx solid var(--line);
}

.calTitle {
    font-size: 30rpx;
    font-weight: 600;
    color: var(--fg);
    letter-spacing: 0.5rpx;
}

.calWeek, .calGrid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 8rpx;
}

.calWeek wx-text {
    text-align: center;
    font-size: 22rpx;
    color: var(--muted);
    padding: 12rpx 0;
    letter-spacing: 0.5rpx;
}

.calCell {
    text-align: center;
    padding: 22rpx 0;
    /* 小控件保留小圆角（14rpx），不收敛到全局 --r */
    border-radius: 14rpx;
    font-size: 26rpx;
    color: var(--fg);
    background: #ffffff;
    font-variant-numeric: tabular-nums;
    transition: all 0.25s cubic-bezier(0.22, 0.61, 0.36, 1);
    border: 1rpx solid transparent;
}

.calCell.muted {
    color: var(--muted);
    background: transparent;
}

.calCell.on {
    background: var(--teal);
    color: #ffffff;
    font-weight: 600;
    border-color: var(--teal);
    box-shadow: 0 6rpx 16rpx rgba(15, 142, 168, 0.28);
}

.calEdit, .calConfirm {
    flex: 1;
    text-align: center;
    font-size: 28rpx;
    padding: 22rpx 0;
    /* 小控件保留小圆角（14rpx），不收敛到全局 --r */
    border-radius: 14rpx;
    font-weight: 500;
    transition: all 0.25s cubic-bezier(0.22, 0.61, 0.36, 1);
    letter-spacing: 0.5rpx;
}

.calEdit {
    background: #ffffff;
    color: var(--fg);
    border: 1rpx solid var(--line);
}

.calConfirm {
    background: var(--teal);
    color: #ffffff;
    box-shadow: 0 6rpx 16rpx rgba(15, 142, 168, 0.24);
}

.editorActions {
    display: flex;
    gap: 20rpx;
    margin-top: 36rpx;
    padding-bottom: 96rpx;
}

.editorBtn {
    flex: 1;
    text-align: center;
    font-size: 30rpx;
    font-weight: 500;
    padding: 28rpx 0;
    border-radius: 18rpx;
    transition: all 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
    letter-spacing: 1rpx;
}

.editorBtn.ghost {
    background: rgba(31, 110, 140, 0.05);
    color: var(--fg);
}

.editorBtn.primary {
    background: var(--teal);
    color: #ffffff;
    box-shadow: 0 8rpx 20rpx rgba(15, 142, 168, 0.28);
}

.sheetMask {
    position: fixed;
    inset: 0;
    background: rgba(31, 110, 140, 0.4);
    z-index: 60;
    animation: maskFade 0.3s ease both;
}

@keyframes maskFade {
    from {
        opacity: 0;
    }

    to {
        opacity: 1;
    }
}

.sheet {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 61;
    background: #ffffff;
    border-radius: var(--r) var(--r) 0 0;
    padding: 20rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
    box-sizing: border-box;
    animation: sheetUp 0.4s cubic-bezier(0.22, 0.61, 0.36, 1) both;
    box-shadow: 0 -24rpx 68rpx rgba(0, 0, 0, 0.1),
    0 -12rpx 32rpx rgba(0, 0, 0, 0.06);
    max-height: 85vh;
    overflow-y: auto;
}

@keyframes sheetUp {
    from {
        transform: translateY(100%);
    }

    to {
        transform: translateY(0);
    }
}

.sheetGrip {
    width: 72rpx;
    height: 8rpx;
    border-radius: 999rpx;
    background: rgba(31, 110, 140, 0.16);
    margin: 12rpx auto 28rpx;
    transition: background 0.2s ease;
}

.sheetTitle {
    font-size: 38rpx;
    font-weight: 700;
    color: var(--fg);
    margin-bottom: 24rpx;
    letter-spacing: -0.5rpx;
}

.sectionActionPress {
    transform: scale(0.93);
    background: var(--teal-deep);
}

.reminderBtnEditPress {
    background: rgba(15, 142, 168, 0.16);
    transform: scale(0.92);
}

.reminderBtnDeletePress {
    background: rgba(239, 68, 68, 0.16);
    transform: scale(0.92);
}

.emptyBtnPress {
    transform: scale(0.93);
    background: var(--teal-deep);
}

.editRowPress {
    background: rgba(31, 110, 140, 0.02);
}

.repeatOptionPress {
    transform: scale(0.97);
}

.dateBtnPress {
    transform: scale(0.93);
    background: var(--teal-deep);
}

.dateEditBtnPress {
    transform: scale(0.95);
    background: rgba(31, 110, 140, 0.1);
}

.calNavPress {
    background: rgba(31, 110, 140, 0.05);
    transform: scale(0.9);
}

.calCellPress {
    transform: scale(0.9);
}

.calEditPress {
    transform: scale(0.95);
    background: rgba(31, 110, 140, 0.03);
}

.calConfirmPress {
    transform: scale(0.95);
    background: var(--teal-deep);
}

.editorBtnGhostPress {
    background: rgba(31, 110, 140, 0.1);
    transform: scale(0.96);
}

.editorBtnPrimaryPress {
    background: var(--teal-deep);
    transform: scale(0.96);
}

/* ===== 平板 / 宽窗适配（覆盖值用 px：rpx 在宽屏随窗口等比放大）===== */
@media (min-width: 768px) {
    .pageScroll {
        padding: 32rpx 5% 180rpx;
        padding-bottom: calc(180rpx + constant(safe-area-inset-bottom));
        padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
    }

    /* 内容列收窄居中（scroll-view 直接子元素即卡片级容器） */
    .overviewCard,
    .section {
        max-width: 720px;
        margin-left: auto;
        margin-right: auto;
    }

    /* 底部弹层保持贴底圆顶形态，横向居中收窄；
     * 日期下拉 / 日历面板在 sheet 内部随之收窄 */
    .sheet {
        left: 0;
        right: 0;
        max-width: 720px;
        margin: 0 auto;
    }

    /* 展示型大字号 px 上限 */
    .overviewAmount {
        font-size: 64px;
    }

    .reminderTime {
        font-size: 40px;
    }
}
