.page {
    position: relative;
    min-height: 100vh;
    background: #FFFFFF;
    color: #111111;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "PingFang SC",
    "Helvetica Neue", "Microsoft YaHei", system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.5rpx;
    animation: none;
    will-change: auto;
}

.pageScroll {
    position: relative;
    z-index: 1;
    height: 100vh;
    padding: 24rpx 24rpx 160rpx;
    box-sizing: border-box;
}

.anim-fadeInUp {
    animation: fadeInUp 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
    will-change: opacity, transform;
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(20rpx);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@media (prefers-reduced-motion: reduce) {
    .anim-fadeInUp {
        animation: none;
        will-change: auto;
    }
}

.overviewCard {
    background: #FFFFFF;
    border: 1rpx solid rgba(31, 110, 140, 0.08);
    border-radius: 44rpx;
    padding: 48rpx 44rpx;
    color: #111111;
    margin-bottom: 36rpx;
    position: relative;
    overflow: hidden;
    box-shadow: 0 24rpx 68rpx rgba(31, 110, 140, 0.1),
    0 12rpx 32rpx rgba(31, 110, 140, 0.06),
    0 4rpx 12rpx rgba(31, 110, 140, 0.03);
}

.overviewBg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
}

.overviewOrb {
    position: absolute;
    border-radius: 50%;
    filter: blur(48rpx);
}

.overviewOrb.orb1 {
    width: 320rpx;
    height: 320rpx;
    background: radial-gradient(circle, rgba(93, 173, 226, 0.22) 0%, transparent 70%);
    top: -100rpx;
    right: -80rpx;
    animation: orbFloat1 12s ease-in-out infinite;
}

.overviewOrb.orb2 {
    width: 240rpx;
    height: 240rpx;
    background: radial-gradient(circle, rgba(41, 128, 185, 0.18) 0%, transparent 70%);
    bottom: -80rpx;
    left: -60rpx;
    animation: orbFloat2 16s ease-in-out infinite;
}

@keyframes orbFloat1 {
    0%, 100% {
        transform: translate(0, 0) scale(1);
        opacity: 0.7;
    }

    50% {
        transform: translate(-40rpx, 30rpx) scale(1.25);
        opacity: 1;
    }
}

@keyframes orbFloat2 {
    0%, 100% {
        transform: translate(0, 0) scale(1);
        opacity: 0.6;
    }

    50% {
        transform: translate(30rpx, -25rpx) scale(1.2);
        opacity: 0.9;
    }
}

.overviewLabel {
    font-size: 22rpx;
    color: #9aa6b0;
    font-weight: 500;
    letter-spacing: 4rpx;
    text-transform: uppercase;
    display: block;
    margin-bottom: 24rpx;
    position: relative;
    z-index: 1;
}

.overviewMain {
    display: flex;
    align-items: baseline;
    gap: 8rpx;
    margin-bottom: 14rpx;
    position: relative;
    z-index: 1;
}

.overviewAmount {
    font-size: 112rpx;
    font-weight: 700;
    letter-spacing: -4rpx;
    line-height: 1;
    background: linear-gradient(180deg, #111111 0%, #1f6e8c 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: numberPulse 4s ease-in-out infinite;
}

@keyframes numberPulse {
    0%, 100% {
        transform: scale(1);
    }

    50% {
        transform: scale(1.015);
    }
}

.overviewUnit {
    font-size: 28rpx;
    color: #6b7a85;
    font-weight: 500;
    letter-spacing: 1rpx;
}

.overviewGoal {
    font-size: 24rpx;
    color: #9aa6b0;
    margin-bottom: 36rpx;
    letter-spacing: 0.5rpx;
    position: relative;
    z-index: 1;
}

.overviewProgress {
    height: 10rpx;
    background: rgba(31, 110, 140, 0.08);
    border-radius: 999rpx;
    overflow: hidden;
    margin-bottom: 28rpx;
    position: relative;
    z-index: 1;
}

.overviewFill {
    height: 100%;
    background: linear-gradient(90deg, #7FBED8 0%, #CEECF5 100%);
    border-radius: 999rpx;
    transition: width 1s cubic-bezier(0.22, 0.61, 0.36, 1);
    position: relative;
    overflow: hidden;
}

.overviewFill::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.5), transparent);
    animation: shimmer 2.5s ease-in-out infinite;
}

@keyframes shimmer {
    0% {
        left: -100%;
    }

    60%, 100% {
        left: 100%;
    }
}

.overviewFill::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 24rpx;
    height: 100%;
    background: rgba(255, 255, 255, 0.85);
    border-radius: 50%;
    filter: blur(6rpx);
}

.overviewFooter {
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
    z-index: 1;
}

.overviewPercent {
    font-size: 28rpx;
    color: #111111;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.5rpx;
}

.overviewStatus {
    font-size: 22rpx;
    padding: 10rpx 22rpx;
    background: rgba(127, 190, 216, 0.16);
    border: 1rpx solid rgba(127, 190, 216, 0.32);
    border-radius: 999rpx;
    font-weight: 500;
    letter-spacing: 1rpx;
    color: #1f6e8c;
    animation: statusBreathe 3s ease-in-out infinite;
}

@keyframes statusBreathe {
    0%, 100% {
        box-shadow: 0 0 0 0 rgba(127, 190, 216, 0);
    }

    50% {
        box-shadow: 0 0 0 8rpx rgba(127, 190, 216, 0.12);
    }
}

.section {
    margin-bottom: 36rpx;
}

.sectionHeader {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 28rpx;
}

.sectionTitle {
    font-size: 38rpx;
    font-weight: 700;
    letter-spacing: -0.5rpx;
    color: #111111;
}

.sectionAction {
    font-size: 26rpx;
    color: #ffffff;
    font-weight: 500;
    padding: 14rpx 30rpx;
    background: #7FBED8;
    border-radius: 999rpx;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    position: relative;
    overflow: hidden;
    letter-spacing: 1rpx;
    box-shadow: 0 8rpx 20rpx rgba(41, 128, 185, 0.28);
}

.sectionAction:active {
    transform: scale(0.93);
    background: #1f6e8c;
}

.sectionAction::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, rgba(255,255,255,0.4) 0%, transparent 70%);
    transform: scale(0);
    opacity: 0;
    transition: all 0.5s ease;
}

.sectionAction:active::after {
    transform: scale(2.5);
    opacity: 1;
}

.reminderList {
    display: flex;
    flex-direction: column;
    gap: 16rpx;
}

.reminderItem {
    background: #ffffff;
    border: 1rpx solid rgba(31, 110, 140, 0.06);
    border-radius: 32rpx;
    padding: 32rpx;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    position: relative;
    box-shadow: 0 12rpx 32rpx rgba(31, 110, 140, 0.06),
    0 4rpx 12rpx rgba(31, 110, 140, 0.03);
    animation: itemSlideIn 0.6s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

@keyframes itemSlideIn {
    from {
        opacity: 0;
        transform: translateX(-24rpx);
    }

    to {
        opacity: 1;
        transform: translateX(0);
    }
}

.reminderItem::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4rpx;
    height: 100%;
    background: linear-gradient(180deg, #7FBED8 0%, #CEECF5 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
}

.reminderItem:active {
    transform: scale(0.98) translateY(-2rpx);
    border-color: rgba(41, 128, 185, 0.16);
    box-shadow: 0 16rpx 40rpx rgba(31, 110, 140, 0.1),
    0 6rpx 16rpx rgba(31, 110, 140, 0.06);
}

.reminderItem:active::before {
    opacity: 1;
}

.reminderItem.isDone {
    background: #f7fafb;
}

.reminderItem.isDone::before {
    opacity: 0.4;
    background: #CEECF5;
}

.reminderLeft {
    display: flex;
    align-items: center;
    gap: 24rpx;
}

.reminderTimeWrapper {
    display: flex;
    flex-direction: column;
    gap: 8rpx;
}

.reminderTime {
    font-size: 50rpx;
    font-weight: 700;
    letter-spacing: -1.5rpx;
    font-variant-numeric: tabular-nums;
    background: linear-gradient(180deg, #111111 0%, #1f6e8c 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    transition: transform 0.3s ease;
}

.reminderItem:active .reminderTime {
    transform: scale(0.97);
}

.reminderRepeat {
    font-size: 24rpx;
    color: #6b7a85;
    letter-spacing: 0.5rpx;
}

.reminderBadge {
    font-size: 20rpx;
    padding: 8rpx 18rpx;
    border-radius: 999rpx;
    font-weight: 500;
    letter-spacing: 1rpx;
    transition: all 0.3s ease;
}

.reminderBadge.upcoming {
    background: rgba(31, 110, 140, 0.06);
    color: #6b7a85;
}

.reminderBadge.completed {
    background: rgba(41, 128, 185, 0.1);
    color: #7FBED8;
    border: 1rpx solid rgba(41, 128, 185, 0.2);
}

.reminderActions {
    display: flex;
    gap: 12rpx;
}

.reminderBtn {
    width: 64rpx;
    height: 64rpx;
    border-radius: 18rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    position: relative;
    overflow: hidden;
}

.reminderBtn::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, rgba(255,255,255,0.5) 0%, transparent 70%);
    transform: scale(0);
    opacity: 0;
    transition: all 0.4s ease;
}

.reminderBtn:active::after {
    transform: scale(1.5);
    opacity: 1;
}

.reminderBtn.edit {
    background: rgba(41, 128, 185, 0.08);
}

.reminderBtn.edit:active {
    background: rgba(41, 128, 185, 0.16);
    transform: scale(0.88) rotate(10deg);
}

.reminderBtn.delete {
    background: rgba(217, 96, 88, 0.08);
}

.reminderBtn.delete:active {
    background: rgba(217, 96, 88, 0.16);
    transform: scale(0.88) rotate(-10deg);
}

.btnIcon {
    font-size: 28rpx;
    line-height: 1;
    position: relative;
    z-index: 1;
}

.reminderBtn.edit .btnIcon {
    color: #7FBED8;
}

.reminderBtn.delete .btnIcon {
    color: #d96058;
}

.emptyState {
    text-align: center;
    padding: 100rpx 60rpx;
    background: #ffffff;
    border-radius: 32rpx;
    border: 1rpx dashed rgba(31, 110, 140, 0.16);
}

.emptyIcon {
    width: 140rpx;
    height: 140rpx;
    background: linear-gradient(135deg, rgba(41, 128, 185, 0.06) 0%, rgba(93, 173, 226, 0.06) 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 32rpx;
    position: relative;
    animation: emptyBreathe 3s ease-in-out infinite;
}

@keyframes emptyBreathe {
    0%, 100% {
        transform: scale(1);
        box-shadow: 0 0 0 0 rgba(41, 128, 185, 0);
    }

    50% {
        transform: scale(1.05);
        box-shadow: 0 0 0 16rpx rgba(41, 128, 185, 0.04);
    }
}

.emptyIconRing {
    position: absolute;
    inset: -8rpx;
    border-radius: 50%;
    border: 2rpx dashed rgba(41, 128, 185, 0.3);
    animation: rotate 20s linear infinite;
}

@keyframes rotate {
    from {
        transform: rotate(0deg);
    }

    to {
        transform: rotate(360deg);
    }
}

.emptyIconText {
    font-size: 56rpx;
    color: #7FBED8;
    font-weight: 300;
    line-height: 1;
    position: relative;
    z-index: 1;
}

.emptyText {
    font-size: 28rpx;
    color: #6b7a85;
    display: block;
    margin-bottom: 36rpx;
    letter-spacing: 0.5rpx;
}

.emptyBtn {
    display: inline-block;
    font-size: 26rpx;
    font-weight: 500;
    color: #ffffff;
    background: #7FBED8;
    padding: 22rpx 52rpx;
    border-radius: 999rpx;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    position: relative;
    overflow: hidden;
    letter-spacing: 1rpx;
    box-shadow: 0 12rpx 28rpx rgba(41, 128, 185, 0.28);
}

.emptyBtn:active {
    transform: scale(0.93);
    background: #1f6e8c;
}

.emptyBtn::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, rgba(255,255,255,0.4) 0%, transparent 70%);
    transform: scale(0);
    opacity: 0;
    transition: all 0.5s ease;
}

.emptyBtn:active::after {
    transform: scale(2.5);
    opacity: 1;
}

.editRow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28rpx 0;
    border-bottom: 1rpx solid rgba(31, 110, 140, 0.06);
    transition: background 0.2s ease;
}

.editRow:last-child {
    border-bottom: none;
}

.editRow:active {
    background: rgba(31, 110, 140, 0.02);
}

.editLabel {
    font-size: 28rpx;
    color: #6b7a85;
    letter-spacing: 0.5rpx;
}

.editValue {
    font-size: 28rpx;
    font-weight: 500;
    color: #111111;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.5rpx;
}

.editValueRow {
    display: flex;
    align-items: center;
    gap: 12rpx;
}

.editArrow {
    color: #b5bec5;
    font-size: 32rpx;
    font-weight: 300;
    transition: transform 0.2s ease;
}

.editRow:active .editArrow {
    transform: translateX(4rpx);
}

.repeatMenu {
    margin-top: 16rpx;
    background: rgba(31, 110, 140, 0.03);
    border-radius: 22rpx;
    padding: 8rpx;
    animation: menuIn 0.3s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

@keyframes menuIn {
    from {
        opacity: 0;
        transform: translateY(-8rpx);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.repeatOption {
    padding: 24rpx 28rpx;
    border-radius: 14rpx;
    font-size: 28rpx;
    color: #111111;
    transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    letter-spacing: 0.5rpx;
}

.repeatOption:active {
    transform: scale(0.97);
}

.repeatOption.on {
    background: #7FBED8;
    color: #ffffff;
    font-weight: 500;
    box-shadow: 0 8rpx 20rpx rgba(41, 128, 185, 0.28);
}

.dateRow {
    display: flex;
    align-items: center;
    gap: 20rpx;
    padding: 28rpx 0;
    border-bottom: 1rpx solid rgba(31, 110, 140, 0.06);
}

.dateSummary {
    flex: 1;
    font-size: 28rpx;
    color: #111111;
    letter-spacing: 0.5rpx;
}

.dateBtn {
    font-size: 24rpx;
    color: #ffffff;
    padding: 14rpx 28rpx;
    border-radius: 14rpx;
    background: #7FBED8;
    font-weight: 500;
    transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    letter-spacing: 0.5rpx;
}

.dateBtn:active {
    transform: scale(0.93);
    background: #1f6e8c;
}

.dateDropdown {
    margin-top: 16rpx;
}

.dateChips {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
    padding: 20rpx 0;
}

.dateChip {
    font-size: 22rpx;
    padding: 12rpx 24rpx;
    border-radius: 999rpx;
    background: #7FBED8;
    color: #ffffff;
    letter-spacing: 0.5rpx;
    animation: chipIn 0.25s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    box-shadow: 0 4rpx 12rpx rgba(41, 128, 185, 0.2);
}

@keyframes chipIn {
    from {
        opacity: 0;
        transform: scale(0.8);
    }

    to {
        opacity: 1;
        transform: scale(1);
    }
}

.dateEmpty {
    font-size: 24rpx;
    color: #9aa6b0;
    padding: 20rpx 0;
    letter-spacing: 0.5rpx;
}

.dateEditRow, .calActions {
    display: flex;
    gap: 16rpx;
    margin-top: 20rpx;
}

.dateEditBtn {
    flex: 1;
    text-align: center;
    font-size: 26rpx;
    padding: 20rpx 0;
    border-radius: 14rpx;
    background: rgba(31, 110, 140, 0.05);
    color: #111111;
    font-weight: 500;
    transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    letter-spacing: 0.5rpx;
}

.dateEditBtn:active {
    transform: scale(0.95);
    background: rgba(31, 110, 140, 0.1);
}

.dateEditBtn.primary {
    background: #7FBED8;
    color: #ffffff;
    box-shadow: 0 6rpx 16rpx rgba(41, 128, 185, 0.24);
}

.dateEditBtn.primary:active {
    background: #1f6e8c;
}

.calendarPanel {
    margin-top: 24rpx;
    background: rgba(31, 110, 140, 0.03);
    border-radius: 24rpx;
    padding: 28rpx;
    box-sizing: border-box;
    animation: calendarIn 0.35s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

@keyframes calendarIn {
    from {
        opacity: 0;
        transform: translateY(-12rpx);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.calHeader {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24rpx;
}

.calNav {
    width: 68rpx;
    height: 68rpx;
    border-radius: 50%;
    background: #ffffff;
    text-align: center;
    line-height: 68rpx;
    font-size: 28rpx;
    color: #6b7a85;
    transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    border: 1rpx solid rgba(31, 110, 140, 0.06);
}

.calNav:active {
    background: rgba(31, 110, 140, 0.05);
    transform: scale(0.9);
}

.calTitle {
    font-size: 30rpx;
    font-weight: 600;
    color: #111111;
    letter-spacing: 0.5rpx;
}

.calWeek, .calGrid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 8rpx;
}

.calWeek wx-text {
    text-align: center;
    font-size: 22rpx;
    color: #9aa6b0;
    padding: 12rpx 0;
    letter-spacing: 0.5rpx;
}

.calCell {
    text-align: center;
    padding: 22rpx 0;
    border-radius: 14rpx;
    font-size: 26rpx;
    color: #111111;
    background: #ffffff;
    font-variant-numeric: tabular-nums;
    transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    border: 1rpx solid transparent;
}

.calCell:active {
    transform: scale(0.9);
}

.calCell.muted {
    color: #c4ccd2;
    background: transparent;
}

.calCell.on {
    background: #7FBED8;
    color: #ffffff;
    font-weight: 600;
    border-color: #7FBED8;
    box-shadow: 0 6rpx 16rpx rgba(41, 128, 185, 0.28);
}

.calCell.on:active {
    background: #1f6e8c;
}

.calEdit, .calConfirm {
    flex: 1;
    text-align: center;
    font-size: 28rpx;
    padding: 22rpx 0;
    border-radius: 14rpx;
    font-weight: 500;
    transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    letter-spacing: 0.5rpx;
}

.calEdit {
    background: #ffffff;
    color: #111111;
    border: 1rpx solid rgba(31, 110, 140, 0.08);
}

.calEdit:active {
    transform: scale(0.95);
    background: rgba(31, 110, 140, 0.03);
}

.calConfirm {
    background: #7FBED8;
    color: #ffffff;
    box-shadow: 0 6rpx 16rpx rgba(41, 128, 185, 0.24);
}

.calConfirm:active {
    transform: scale(0.95);
    background: #1f6e8c;
}

.editorActions {
    display: flex;
    gap: 20rpx;
    margin-top: 36rpx;
    padding-bottom: 96rpx;
}

.editorBtn {
    flex: 1;
    text-align: center;
    font-size: 30rpx;
    font-weight: 500;
    padding: 28rpx 0;
    border-radius: 18rpx;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    position: relative;
    overflow: hidden;
    letter-spacing: 1rpx;
}

.editorBtn::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, rgba(255,255,255,0.3) 0%, transparent 70%);
    transform: scale(0);
    opacity: 0;
    transition: all 0.4s ease;
}

.editorBtn:active::after {
    transform: scale(2);
    opacity: 1;
}

.editorBtn.ghost {
    background: rgba(31, 110, 140, 0.05);
    color: #111111;
}

.editorBtn.ghost:active {
    background: rgba(31, 110, 140, 0.1);
    transform: scale(0.96);
}

.editorBtn.primary {
    background: #7FBED8;
    color: #ffffff;
    box-shadow: 0 8rpx 20rpx rgba(41, 128, 185, 0.28);
}

.editorBtn.primary:active {
    background: #1f6e8c;
    transform: scale(0.96);
}

.sheetMask {
    position: fixed;
    inset: 0;
    background: rgba(31, 110, 140, 0.4);
    z-index: 60;
    animation: maskFade 0.3s ease both;
}

@keyframes maskFade {
    from {
        opacity: 0;
    }

    to {
        opacity: 1;
    }
}

.sheet {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 61;
    background: #ffffff;
    border-radius: 44rpx 44rpx 0 0;
    padding: 20rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
    box-sizing: border-box;
    animation: sheetUp 0.4s cubic-bezier(0.22, 0.61, 0.36, 1) both;
    box-shadow: 0 -24rpx 68rpx rgba(31, 110, 140, 0.12),
    0 -12rpx 32rpx rgba(31, 110, 140, 0.08);
    max-height: 85vh;
    overflow-y: auto;
}

@keyframes sheetUp {
    from {
        transform: translateY(100%);
    }

    to {
        transform: translateY(0);
    }
}

.sheetGrip {
    width: 72rpx;
    height: 8rpx;
    border-radius: 999rpx;
    background: rgba(31, 110, 140, 0.16);
    margin: 12rpx auto 28rpx;
    transition: background 0.2s ease;
}

.sheetTitle {
    font-size: 38rpx;
    font-weight: 700;
    color: #111111;
    margin-bottom: 24rpx;
    letter-spacing: -0.5rpx;
}

.sectionActionPress {
    transform: scale(0.93);
    background: #1f6e8c;
}

.reminderBtnEditPress {
    background: rgba(41, 128, 185, 0.16);
    transform: scale(0.88) rotate(10deg);
}

.reminderBtnDeletePress {
    background: rgba(217, 96, 88, 0.16);
    transform: scale(0.88) rotate(-10deg);
}

.emptyBtnPress {
    transform: scale(0.93);
    background: #1f6e8c;
}

.editRowPress {
    background: rgba(31, 110, 140, 0.02);
}

.repeatOptionPress {
    transform: scale(0.97);
}

.dateBtnPress {
    transform: scale(0.93);
    background: #1f6e8c;
}

.dateEditBtnPress {
    transform: scale(0.95);
    background: rgba(31, 110, 140, 0.1);
}

.calNavPress {
    background: rgba(31, 110, 140, 0.05);
    transform: scale(0.9);
}

.calCellPress {
    transform: scale(0.9);
}

.calEditPress {
    transform: scale(0.95);
    background: rgba(31, 110, 140, 0.03);
}

.calConfirmPress {
    transform: scale(0.95);
    background: #1f6e8c;
}

.editorBtnGhostPress {
    background: rgba(31, 110, 140, 0.1);
    transform: scale(0.96);
}

.editorBtnPrimaryPress {
    background: #1f6e8c;
    transform: scale(0.96);
}
