.homeQuickTitleRow {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
}

.homeQuickTitle {
    font-size: 30rpx;
    font-weight: 800;
    color: rgba(17,17,17,.92);
    margin-right: 10rpx;
}

.homeCupWater {
    font-size: 22rpx;
    font-weight: 700;
    color: rgba(17,17,17,.72);
    line-height: 1.2;
    margin-top: 2rpx;
    margin-right: 10rpx;
}

.homeQuickToday {
    font-size: 22rpx;
    font-weight: 700;
    color: rgba(17,17,17,.62);
    line-height: 1.2;
    margin-top: 2rpx;
}

.homeQuickRecordBtn {
    height: 48rpx;
    min-width: 82rpx;
    border-radius: 999rpx;
    padding: 0 18rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22rpx;
    font-weight: 800;
    color: rgba(17,17,17,.65);
    background: rgba(17,17,17,.08);
    margin-left: 12rpx;
}

.homeQuickRow {
    margin-top: 16rpx;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    row-gap: 12rpx;
}

.homeQuickBtn {
    width: 48.5%;
    flex: 0 0 48.5%;
    min-width: 0;
    height: 74rpx;
    border-radius: 18rpx;
    background: rgba(41, 191, 212, 0.16);
    border: 1px solid rgba(17, 152, 180, 0.28);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26rpx;
    font-weight: 700;
    color: #0f8ea8;
    margin-bottom: 0;
}

.homeCustomRow {
    margin-top: 12rpx;
    display: flex;
    align-items: center;
    column-gap: 10rpx;
}

.homeAmountInput {
    flex: 1;
    height: 76rpx;
    border-radius: 18rpx;
    padding: 0 20rpx;
    background: rgba(255,255,255,.95);
    border: 1px solid rgba(17,17,17,.08);
    font-size: 26rpx;
    color: #111111;
    box-sizing: border-box;
}

.homeConfirmBtn {
    width: 148rpx;
    height: 76rpx;
    border-radius: 18rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26rpx;
    font-weight: 700;
    color: #ffffff;
    background: linear-gradient(90deg, #7ddbe8 0%, #29bfd4 60%, #bfeff5 100%);
    box-shadow: 0 10rpx 22rpx rgba(17, 152, 180, 0.22);
    margin-left: 0;
}

.press {
    transform: scale(.985);
    opacity: .92;
}


@media screen and (max-width: 359px) {
    .page {
        padding-left: 2.6%;
        padding-right: 2.6%;
    }

    .controlPad {
        margin-top: 22rpx;
    }

    .padWord {
        font-size: 38rpx;
        letter-spacing: 2rpx;
    }

    .padSub {
        font-size: 18rpx;
    }

    .homeHeroCard {
        padding: 20rpx;
        gap: 16rpx;
    }

    .homeHeroActions {
        width: 100%;
        justify-content: space-between;
    }

    .homeGoalChip, .homeRecordBtn {
        flex: 1 1 0;
        min-width: 0;
    }

    .homeHeroMain {
        grid-template-columns: 1fr;
    }

    .homeHeroMain > .homeHeroAmount, .homeCupWaterBlock {
        min-height: 0;
    }

    .homeQuickCard {
        margin-top: 42rpx;
        padding: 16rpx;
    }
}

@media screen and (min-width: 768px) {
    .page {
        padding-left: 5%;
        padding-right: 5%;
    }

    .controlPad {
        margin-top: 38rpx;
    }

    .homeHeroCard {
        max-width: 900rpx;
        align-self: center;
    }

    .homeQuickCard {
        max-width: 900rpx;
        margin-top: 56rpx;
        padding: 22rpx;
    }

    .homeQuickRow {
        justify-content: space-between;
        row-gap: 12rpx;
    }
}

@media screen and (min-width: 1200px) {
    .page {
        max-width: 1280px;
        margin: 0 auto;
        padding-left: 6.5%;
        padding-right: 6.5%;
    }

    .homeHeroCard {
        max-width: 980rpx;
    }

    .homeQuickCard {
        max-width: 980rpx;
    }
}
