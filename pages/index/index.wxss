.controlPad {
    position: relative;
    z-index: 2;
    width: 552rpx;
    height: 444rpx;
    margin: 28rpx auto 0;
    display: grid;
    grid-template-columns: repeat(2, 270rpx);
    grid-template-rows: repeat(2, 214rpx);
    column-gap: 12rpx;
    row-gap: 16rpx;
    justify-content: center;
    align-content: center;
    --heat-side-shift: 32rpx;
    --heat-float-offset: 10rpx;
    --heat-move-duration: 1.05s;
    --heat-sync-duration: 2.6s;
}

.padItem {
    position: relative;
    width: 270rpx;
    height: 214rpx;
    padding: 16rpx;
    box-sizing: border-box;
    border-radius: 28rpx;
    background: #FFFFFF;
    border: 2rpx solid rgba(145,206,221,.30);
    box-shadow: 0 18rpx 44rpx rgba(13,70,92,.11),
    0 6rpx 14rpx rgba(13,70,92,.05),
    inset 0 0 0 2rpx rgba(255,255,255,.95);
    display: flex;
    overflow: hidden;
    transform: translate3d(0, 0, 0);
    transition: transform 0.18s ease,
    box-shadow 0.28s ease;
    will-change: transform;
    backface-visibility: hidden;
}

.padTL {
    grid-column: 1;
    grid-row: 1;
    align-items: flex-start;
    justify-content: flex-start;
    border-color: rgba(126,194,209,.44);
}

.padTR {
    grid-column: 2;
    grid-row: 1;
    align-items: flex-start;
    justify-content: flex-end;
    text-align: right;
    border-color: rgba(120,189,206,.44);
}

.padBL {
    grid-column: 1;
    grid-row: 2;
    align-items: flex-end;
    justify-content: flex-start;
    border-color: rgba(122,202,194,.44);
}

.padBR {
    grid-column: 2;
    grid-row: 2;
    align-items: flex-end;
    justify-content: flex-end;
    text-align: right;
    border-color: rgba(123,192,210,.44);
}

.padInk {
    position: relative;
    z-index: 4;
    display: flex;
    flex-direction: column;
    gap: 10rpx;
    will-change: transform;
}

.padIcon {
    width: 58rpx;
    height: 58rpx;
    display: block;
}

.padTR .padInk, .padBR .padInk {
    align-items: flex-end;
}

.padTL .padInk {
    margin-left: 24rpx;
    margin-top: 16rpx;
}

.padTR .padInk {
    margin-right: 24rpx;
    margin-top: 16rpx;
}

.padBL .padInk {
    margin-left: 24rpx;
    margin-bottom: 16rpx;
}

.padBR .padInk {
    margin-right: 24rpx;
    margin-bottom: 16rpx;
}

.padWord {
    font-size: 44rpx;
    line-height: 1;
    font-family: "STXingkai","STHupo","HanziPen SC","DFKai-SB","KaiTi","cursive";
    font-weight: 900;
    color: rgba(17,17,17,.92);
    letter-spacing: 4rpx;
}

.padSub {
    font-size: 20rpx;
    font-family: "STKaiti","KaiTi","serif";
    font-weight: 700;
    color: rgba(17,17,17,.74);
    letter-spacing: 1rpx;
}

.padItem::before {
    content: "";
    position: absolute;
    left: 10rpx;
    right: 10rpx;
    top: 10rpx;
    bottom: 10rpx;
    border-radius: 20rpx;
    border: 1px solid rgba(17,17,17,.08);
    z-index: 1;
}

.padItem::after {
    content: "";
    position: absolute;
    left: 16rpx;
    right: 16rpx;
    top: 16rpx;
    bottom: 16rpx;
    border-radius: 16rpx;
    border: 1px dashed rgba(17,17,17,.08);
    z-index: 1;
}

.padTL::after {
    border-style: solid dashed dashed solid;
}

.padTR::after {
    border-style: solid solid dashed dashed;
}

.padBL::after {
    border-style: dashed solid solid dashed;
}

.padBR::after {
    border-style: dashed dashed solid solid;
}

.padLayer {
    position: absolute;
    z-index: 2;
    pointer-events: none;
}

.padLayerLine {
    width: 96rpx;
    height: 22rpx;
    border-top: 3rpx solid rgba(17,152,180,.22);
    border-radius: 999rpx;
}

.padLayerRing {
    width: 54rpx;
    height: 54rpx;
    border-radius: 50%;
    border: 2rpx solid rgba(17,152,180,.22);
    background: rgba(17,152,180,.05);
}

.padLayerTag {
    width: 24rpx;
    height: 24rpx;
    border-radius: 8rpx;
    border: 2rpx solid rgba(17,152,180,.26);
    background: rgba(17,152,180,.08);
}

.padTL .padLayerLine {
    left: 24rpx;
    bottom: 34rpx;
    transform: rotate(-8deg);
}

.padTL .padLayerRing {
    right: 28rpx;
    top: 28rpx;
}

.padTL .padLayerTag {
    right: 56rpx;
    top: 54rpx;
    border-radius: 50%;
}

.padTR .padLayerLine {
    right: 24rpx;
    bottom: 34rpx;
    transform: rotate(8deg);
}

.padTR .padLayerRing {
    left: 28rpx;
    top: 28rpx;
    border-style: dashed;
}

.padTR .padLayerTag {
    left: 56rpx;
    top: 54rpx;
    transform: rotate(45deg);
}

.padBL .padLayerLine {
    left: 24rpx;
    top: 34rpx;
    transform: rotate(8deg);
}

.padBL .padLayerRing {
    right: 28rpx;
    bottom: 28rpx;
    box-shadow: 0 0 0 4rpx rgba(17,152,180,.06);
}

.padBL .padLayerTag {
    right: 60rpx;
    bottom: 60rpx;
    width: 18rpx;
    height: 18rpx;
    border-radius: 50%;
}

.padBR .padLayerLine {
    right: 24rpx;
    top: 34rpx;
    transform: rotate(-8deg);
}

.padBR .padLayerRing {
    left: 28rpx;
    bottom: 28rpx;
    border-style: dotted;
}

.padBR .padLayerTag {
    left: 60rpx;
    bottom: 62rpx;
    width: 34rpx;
    height: 14rpx;
    border-radius: 999rpx;
}

.controlPad.heating .padTL {
    animation: padEnterLeft var(--heat-move-duration) cubic-bezier(.23,.82,.28,1) forwards,
    padFloatTL var(--heat-sync-duration) ease-in-out var(--heat-move-duration) infinite;
}

.controlPad.heating .padTR {
    animation: padEnterRight var(--heat-move-duration) cubic-bezier(.23,.82,.28,1) forwards,
    padFloatTR var(--heat-sync-duration) ease-in-out var(--heat-move-duration) infinite;
}

.controlPad.heating .padBL {
    animation: padEnterLeft var(--heat-move-duration) cubic-bezier(.23,.82,.28,1) forwards,
    padFloatBL var(--heat-sync-duration) ease-in-out var(--heat-move-duration) infinite;
}

.controlPad.heating .padBR {
    animation: padEnterRight var(--heat-move-duration) cubic-bezier(.23,.82,.28,1) forwards,
    padFloatBR var(--heat-sync-duration) ease-in-out var(--heat-move-duration) infinite;
}

.controlPad.cooling .padTL, .controlPad.cooling .padBL {
    animation: padReturnLeft var(--heat-move-duration) cubic-bezier(.23,.82,.28,1) forwards;
}

.controlPad.cooling .padTR, .controlPad.cooling .padBR {
    animation: padReturnRight var(--heat-move-duration) cubic-bezier(.23,.82,.28,1) forwards;
}

.controlPad.heating .padNotch {
    box-shadow: inset 0 0 0 2rpx rgba(255, 186, 186, .42);
}

.controlPad.heating .padNotch::after {
    opacity: 1;
    animation: arcGlowPulse var(--heat-sync-duration) ease-in-out infinite;
}

.controlPad.heating .padTL .padNotch::after {
    animation-delay: 0s;
}

.controlPad.heating .padTR .padNotch::after {
    animation-delay: .12s;
}

.controlPad.heating .padBL .padNotch::after {
    animation-delay: .24s;
}

.controlPad.heating .padBR .padNotch::after {
    animation-delay: .36s;
}

@keyframes arcGlowPulse {
    0%, 100% {
        border-color: rgba(255, 168, 168, .50);
        box-shadow: 0 0 12rpx rgba(255, 156, 156, .28),
      0 0 24rpx rgba(255, 156, 156, .18);
    }

    50% {
        border-color: rgba(255, 168, 168, .72);
        box-shadow: 0 0 22rpx rgba(255, 144, 144, .44),
      0 0 40rpx rgba(255, 144, 144, .30);
    }
}

@keyframes padEnterLeft {
    from {
        transform: translate3d(0, 0, 0);
    }

    to {
        transform: translate3d(calc(-1 * var(--heat-side-shift)), 0, 0);
    }
}

@keyframes padEnterRight {
    from {
        transform: translate3d(0, 0, 0);
    }

    to {
        transform: translate3d(var(--heat-side-shift), 0, 0);
    }
}

@keyframes padFloatTL {
    0%, 100% {
        transform: translate3d(calc(-1 * var(--heat-side-shift)), 0, 0);
    }

    50% {
        transform: translate3d(calc(-1 * var(--heat-side-shift) - var(--heat-float-offset)), calc(-1 * var(--heat-float-offset)), 0);
    }
}

@keyframes padFloatTR {
    0%, 100% {
        transform: translate3d(var(--heat-side-shift), 0, 0);
    }

    50% {
        transform: translate3d(calc(var(--heat-side-shift) + var(--heat-float-offset)), calc(-1 * var(--heat-float-offset)), 0);
    }
}

@keyframes padFloatBL {
    0%, 100% {
        transform: translate3d(calc(-1 * var(--heat-side-shift)), 0, 0);
    }

    50% {
        transform: translate3d(calc(-1 * var(--heat-side-shift) - var(--heat-float-offset)), var(--heat-float-offset), 0);
    }
}

@keyframes padFloatBR {
    0%, 100% {
        transform: translate3d(var(--heat-side-shift), 0, 0);
    }

    50% {
        transform: translate3d(calc(var(--heat-side-shift) + var(--heat-float-offset)), var(--heat-float-offset), 0);
    }
}

@keyframes padReturnLeft {
    from {
        transform: translate3d(calc(-1 * var(--heat-side-shift)), 0, 0);
    }

    to {
        transform: translate3d(0, 0, 0);
    }
}

@keyframes padReturnRight {
    from {
        transform: translate3d(var(--heat-side-shift), 0, 0);
    }

    to {
        transform: translate3d(0, 0, 0);
    }
}

@keyframes heatAuraPulse {
    0%, 100% {
        transform: translate(-50%, -50%) scale(.92);
        opacity: .24;
    }

    50% {
        transform: translate(-50%, -50%) scale(1.04);
        opacity: .56;
    }
}

@keyframes heatAuraTopPulse {
