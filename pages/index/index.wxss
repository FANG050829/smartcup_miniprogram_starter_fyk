.page {
    min-height: 100vh;
    height: 100vh;
    box-sizing: border-box;
    padding: 0 3.2% 0;
    padding-bottom: 0;
    position: relative;
    overflow-x: hidden;
    overflow-y: hidden;
    color: #111111;
    background: #CEECF5;
    animation: none;
    will-change: auto;
}

.anim-home-scale-in {
    animation: homeScaleIn 420ms cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
    /* 不能留 will-change：transform 值会永久创建堆叠上下文，把加热弹窗
     * 飞行态的球（z-index 提层）困在本模块内，压回遮罩/弹窗之下
     * （与 app.wxss 的 fixed 包含块铁律同理），入场动画期间合成器
     * 本就会自行提升图层，无需 will-change */
}

@keyframes homeScaleIn {
    0% {
        opacity: 0;
        transform: scale(0.92);
    }

    100% {
        opacity: 1;
        transform: scale(1);
    }
}

.anim-home-fade-in {
    animation: homeFadeIn 380ms cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
    /* 同 .anim-home-scale-in：will-change 会让 controlPad 永久成为
     * 堆叠上下文，飞行态的球/气泡层级提不到遮罩之上 */
}

@keyframes homeFadeIn {
    0% {
        opacity: 0;
        transform: translateY(24rpx);
    }

    100% {
        opacity: 1;
        transform: translateY(0);
    }
}

@media (prefers-reduced-motion: reduce) {
    .anim-home-scale-in, .anim-home-fade-in {
        animation: none;
        will-change: auto;
    }
}

