.padNotch {
    position: absolute;
    width: 234rpx;
    height: 234rpx;
    border-radius: 50%;
    background: linear-gradient(180deg, #edf8fc 0%, #eaf5fb 52%, #f3f9fd 100%);
    box-shadow: inset 0 0 0 2rpx rgba(145,206,221,.24);
