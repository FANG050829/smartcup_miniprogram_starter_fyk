}

.padNotch::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2rpx solid rgba(255, 168, 168, .58);
    box-shadow: 0 0 18rpx rgba(255, 156, 156, .36),
    0 0 34rpx rgba(255, 156, 156, .24);
    pointer-events: none;
    opacity: 0;
    transition: opacity .9s ease;
}

.padTL .padNotch {
    right: -122rpx;
    bottom: -122rpx;
}

.padTR .padNotch {
    left: -122rpx;
    bottom: -122rpx;
}

.padBL .padNotch {
    right: -122rpx;
    top: -122rpx;
}

.padBR .padNotch {
    left: -122rpx;
    top: -122rpx;
}


/* 表情伙伴：无垫底，直接镶嵌在四宫格正中央（画布含弹跳余量） */
.padPet {
    position: absolute;
    left: 50%;
    top: 50%;
    /* 居中用负 margin（264rpx 盒的一半即 132rpx，几何与原
     * translate(-50%,-50%) 一致），transform 整段让给飞行位移；
     * 基态常驻 translate3d(0,0,0)：包装层连同同层 canvas 始终处于
     * 提升状态，飞行起止不再发生图层合成切换（none↔matrix 翻转
     * 会在起飞/落定帧产生卡顿），位移只在 0 与落点间过渡 */
    margin: -132rpx 0 0 -132rpx;
    transform: translate3d(0, 0, 0);
    z-index: 6;
    width: 264rpx;
    height: 264rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    /* 飞行由合成器驱动：一次 transform 过渡，不逐帧 setData */
    transition: transform 460ms cubic-bezier(0.22, 0.61, 0.36, 1);
}

/* 表情球拖拽悬浮态（球被拖走/停泊未归）：四宫格整体抬到内容卡片之上，
 * 球才能浮在其他卡片表面；须排在 petFlyRoot 之前——起飞态 controlPad
 * 要让出堆叠上下文（z auto），两者同现时飞行优先 */
.controlPad.padPetFloat {
    z-index: 15;
}

/* 加热面板飞行态：controlPad 临时让出堆叠上下文，球和气泡才能提到
 * 遮罩(30)/面板(31)之上，嵌进面板左上角的凹座（.heatPetSocket）。
 * 仅 z-index:auto 不够——anim-home-fade-in 的 will-change 与播完的
 * fill 动画（100% 帧带 transform，残留恒在）仍会制造堆叠上下文，把
 * 普通 view 的气泡困在面板之下（同层 canvas 靠原生合成浮在上面，
 * view 没这待遇），必须连 will-change/animation 一起摘掉；
 * animation:none 须 !important 压过 .page.fx-on .fx（0,3,0 > 0,2,0） */
.controlPad.petFlyRoot {
    z-index: auto;
    will-change: auto;
    animation: none !important;
}

.padPet.petFlyMode {
    z-index: 32;
}

/* 飞行态气泡让位：padPet 带 transform 后，同层 canvas 会被提升为独立
 * 合成层，部分内核上它会把叠在其矩形内的兄弟视图盖掉（无视 z-index），
 * 气泡左缘与尾巴正好压在 canvas 右缘（canvas 半宽 130rpx，气泡原位
 * 112rpx）被裁。这里把气泡整体移出 canvas 矩形（134rpx 起），底边也
 * 抬到面板顶缘上方，避开面板弹启动画的上冲瞬间 */
.petFlyMode .petBubble {
    left: calc(50% + 134rpx);
    bottom: calc(50% + 44rpx);
}

@media (prefers-reduced-motion: reduce) {
    .padPet {
        transition: none;
    }
}

.padPetBall {
    position: relative;
    z-index: 2;
    pointer-events: auto;
    cursor: pointer;
}

/* 聊天气泡：永远在表情的右上角（完全在球外，不被表情遮挡），
 * 底部左侧带一枚微信样式的倒三角小尾巴指向球；文字横排，最多上下两行 */
.petBubble {
    position: absolute;
    left: calc(50% + 112rpx);
    bottom: calc(50% + 30rpx);
    z-index: 8;
    width: max-content;
    max-width: 264rpx;
    padding: 14rpx 18rpx;
    background: rgba(255, 255, 255, 0.97);
    border: 2rpx solid rgba(145, 206, 221, 0.45);
    border-radius: 20rpx;
    box-shadow: 0 14rpx 34rpx rgba(13, 70, 92, 0.14);
    pointer-events: none;
    animation: petBubbleIn 240ms ease-out both;
}

/* 微信式小尾巴：倒三角从气泡底部左侧垂下。外层三角用气泡描边色，
 * 盖住底边描边后向下伸出；内层白三角收进 3rpx 露出描边，并在底部
 * 留出缺口与气泡内部连通，视觉上就是气泡边框绕着尾巴走一圈 */
.petBubbleTail {
    position: absolute;
    left: 8rpx;
    bottom: -16rpx;
    width: 0;
    height: 0;
    border-left: 12rpx solid transparent;
    border-right: 12rpx solid transparent;
    border-top: 16rpx solid rgba(145, 206, 221, 0.45);
}

.petBubbleTailFill {
    position: absolute;
    left: 10rpx;
    bottom: -12rpx;
    width: 0;
    height: 0;
    border-left: 10rpx solid transparent;
    border-right: 10rpx solid transparent;
    border-top: 13rpx solid rgba(255, 255, 255, 0.97);
}

.petBubbleText {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    font-size: 22rpx;
    font-weight: 500;
    line-height: 1.6;
    color: #102a43;
    text-align: center;
    word-break: keep-all;
}

@keyframes petBubbleIn {
    0% { opacity: 0; }
    100% { opacity: 1; }
}

/* 看向某个按钮：整张卡片（长方形）按压反馈——缩放 + 阴影收紧，不触发跳转 */
.padGlance {
    transform: scale(0.94);
    border-color: rgba(16, 42, 67, 0.38);
    box-shadow: 0 8rpx 22rpx rgba(13, 70, 92, 0.18),
    0 3rpx 8rpx rgba(13, 70, 92, 0.08);
}



