page {
    background: #F7F9FA;
}

.launch {
    position: relative;
    min-height: 100vh;
    box-sizing: border-box;
    overflow: hidden;
    /* 天光到水色的一条连续渐变：46% 水线处无接缝 */
    background: linear-gradient(180deg, #F5F8FA 0%, #F7F9FA 26%, #F0F6F9 38%, #E4F0F6 46%, #D8EBF3 58%, #CBE4F0 76%, #BCDDEA 100%);
    opacity: 1;
    transition: opacity 500ms ease;
}

.launch.leaving {
    opacity: 0;
}

/* ---------- 背景动效：天光两团 + 双暗涌 + 两片水光光斑 ---------- */
.drift {
    position: absolute;
    width: 1600rpx;
    height: 1200rpx;
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
}

.driftA {
    top: -560rpx;
    left: -460rpx;
    background: radial-gradient(closest-side, rgba(232, 242, 248, 0.7), rgba(232, 242, 248, 0) 72%);
    animation: fadeIn 1600ms ease 200ms both, driftA 32s ease-in-out 2s infinite alternate;
}

.driftB {
    bottom: -660rpx;
    right: -540rpx;
    background: radial-gradient(closest-side, rgba(222, 242, 250, 0.95), rgba(222, 242, 250, 0) 72%);
    animation: fadeIn 1600ms ease 400ms both, driftB 26s ease-in-out 2s infinite alternate;
}

@keyframes driftA {
    from {
        transform: translateX(0);
    }

    to {
        transform: translateX(460rpx);
    }
}

@keyframes driftB {
    from {
        transform: translateX(0);
    }

    to {
        transform: translateX(-420rpx);
    }
}

/* 两道更深的浅蓝涌，错周期、反向过境 */
.swell {
    position: absolute;
    pointer-events: none;
    filter: blur(10px);
    opacity: 0;
}

.swell {
    top: 60%;
    left: -30%;
    width: 160%;
    height: 280rpx;
    background: radial-gradient(50% 60% at 50% 50%, rgba(150, 198, 221, 0.3), rgba(150, 198, 221, 0) 70%);
    animation: fadeIn 2000ms ease 1200ms both, swellDrift 26s ease-in-out 3s infinite alternate;
}

.swell2 {
    top: 78%;
    left: -20%;
    width: 150%;
    height: 240rpx;
    background: radial-gradient(50% 60% at 50% 50%, rgba(140, 190, 215, 0.22), rgba(140, 190, 215, 0) 70%);
    filter: blur(12px);
    animation: fadeIn 2200ms ease 1600ms both, swellDrift2 34s ease-in-out 3s infinite alternate;
}

@keyframes swellDrift {
    from {
        transform: translateX(-4%);
    }

    to {
        transform: translateX(9%);
    }
}

@keyframes swellDrift2 {
    from {
        transform: translateX(6%);
    }

    to {
        transform: translateX(-7%);
    }
}

/* 两片水光光斑：白天水面上缓慢游走的亮斑 */
.caustic {
    position: absolute;
    pointer-events: none;
    opacity: 0;
}

.caustic.a {
    top: 55%;
    left: 8%;
    width: 300rpx;
    height: 110rpx;
    background: radial-gradient(50% 50% at 50% 50%, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0) 70%);
    filter: blur(6px);
    animation: fadeIn 1200ms ease 1400ms both, causticA 19s ease-in-out 2s infinite alternate;
}

.caustic.b {
    top: 68%;
    right: 10%;
    width: 240rpx;
    height: 90rpx;
    background: radial-gradient(50% 50% at 50% 50%, rgba(255, 255, 255, 0.42), rgba(255, 255, 255, 0) 70%);
    filter: blur(5px);
    animation: fadeIn 1200ms ease 1700ms both, causticB 23s ease-in-out 2s infinite alternate;
}

@keyframes causticA {
    from {
        transform: translate(0, 0) scale(1);
    }

    to {
        transform: translate(90rpx, 12rpx) scale(1.15);
    }
}

@keyframes causticB {
    from {
        transform: translate(0, 0) scale(1.08);
    }

    to {
        transform: translate(-80rpx, -10rpx) scale(1);
    }
}

/* 贴着水线的天光倒影，随深度迅速让位给水色 */
.sheen {
    position: absolute;
    top: 46%;
    right: 0;
    left: 0;
    height: 160rpx;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.38) 0%, rgba(255, 255, 255, 0) 70%);
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 900ms ease 700ms both, sheenLive 7000ms ease-in-out 1600ms infinite alternate;
}

@keyframes sheenLive {
    from {
        opacity: 1;
        transform: translateY(0);
    }

    to {
        opacity: 0.75;
        transform: translateY(1px);
    }
}

/* ---------- 水平线：中央最亮、两端消隐的发丝线 + 水下倒影 + 缓行光斑 ---------- */
.horizon {
    position: absolute;
    top: 46%;
    right: 0;
    left: 0;
}

.lineWrap {
    position: relative;
    height: 2rpx;
    transform: scaleX(0);
    animation: lineIn 900ms cubic-bezier(0.22, 0.61, 0.36, 1) 150ms both;
}

.line {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 2rpx;
    /* 像雾中地平线：中心清晰提亮，向两端渐渐消隐 */
    background: linear-gradient(90deg,
        rgba(13, 138, 164, 0) 0%,
        rgba(13, 138, 164, 0.22) 14%,
        rgba(13, 138, 164, 0.6) 34%,
        rgba(13, 138, 164, 0.85) 50%,
        rgba(13, 138, 164, 0.6) 66%,
        rgba(13, 138, 164, 0.22) 86%,
        rgba(13, 138, 164, 0) 100%);
    animation: breathe 4200ms ease-in-out infinite alternate;
}

/* 水下倒影：线正下方一条更淡、更柔的同构线 */
.lineShadow {
    position: absolute;
    top: 6rpx;
    right: 0;
    left: 0;
    height: 2rpx;
    filter: blur(1px);
    background: linear-gradient(90deg,
        rgba(13, 138, 164, 0) 0%,
        rgba(13, 138, 164, 0.35) 30%,
        rgba(13, 138, 164, 0.55) 50%,
        rgba(13, 138, 164, 0.35) 70%,
        rgba(13, 138, 164, 0) 100%);
    opacity: 0;
    animation: fadeIn 900ms ease 800ms both;
}

/* 珠下的天光倒影柱：一道轻摇的竖直微光，让水珠有来处 */
.reflection {
    position: absolute;
    top: 3px;
    left: 50%;
    width: 16rpx;
    height: 240rpx;
    margin-left: -8rpx;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.55) 0%, rgba(255, 255, 255, 0) 78%);
    filter: blur(2px);
    transform-origin: 50% 0;
    opacity: 0;
    animation: reflectionIn 800ms ease 1000ms both, reflectionSway 6500ms ease-in-out 1800ms infinite alternate;
}

@keyframes reflectionIn {
    from {
        opacity: 0;
    }

    to {
        opacity: 0.55;
    }
}

@keyframes reflectionSway {
    from {
        transform: rotate(0.5deg);
    }

    to {
        transform: rotate(-0.5deg);
    }
}

/* 沿水线极缓巡行的一粒光斑，首尾淡出、循环往复 */
.glint {
    position: absolute;
    top: -1rpx;
    left: 0;
    width: 200rpx;
    height: 4rpx;
    border-radius: 2rpx;
    filter: blur(1px);
    background: linear-gradient(90deg, rgba(240, 252, 254, 0) 0%, rgba(240, 252, 254, 0.85) 50%, rgba(240, 252, 254, 0) 100%);
    opacity: 0;
    animation: glintIn 900ms ease 1500ms both, glintDrift 14s linear 2400ms infinite;
}

/* ---------- 落水：一滴水从字标后坠落，击中线心 ---------- */
.drop {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 8rpx;
    height: 13rpx;
    margin-left: -4rpx;
    border-radius: 50%;
    background: rgba(23, 150, 178, 0.8);
    opacity: 0;
    animation: dropFall 620ms cubic-bezier(0.55, 0.06, 0.68, 0.19) 1240ms both;
    pointer-events: none;
}

@keyframes dropFall {
    0% {
        opacity: 0;
        transform: translateY(-360rpx) scale(0.9, 1.15);
    }

    10% {
        opacity: 0.9;
    }

    92% {
        opacity: 1;
    }

    100% {
        opacity: 0;
        transform: translateY(0) scale(1.15, 0.8);
    }
}

/* ---------- 注满时刻：水珠摊开，三道羽化波前错峰荡开 ---------- */
.ring {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 90rpx;
    height: 7rpx;
    margin: -3.5rpx 0 0 -45rpx;
    /* 羽化波前：渐变软环，不是描边 */
    background: radial-gradient(closest-side, rgba(15, 142, 168, 0) 52%, rgba(15, 142, 168, 0.6) 72%, rgba(15, 142, 168, 0) 90%);
    opacity: 0;
    pointer-events: none;
}

.launch.settled .r1 {
    animation: ringA 1150ms cubic-bezier(0.16, 0.84, 0.3, 1) both;
}

.launch.settled .r2 {
    animation: ringB 950ms cubic-bezier(0.16, 0.84, 0.3, 1) 200ms both;
}

.launch.settled .r3 {
    animation: ringC 820ms cubic-bezier(0.16, 0.84, 0.3, 1) 420ms both;
}

@keyframes ringA {
    0% {
        opacity: 0;
        transform: scale(0.25, 0.3);
    }

    12% {
        opacity: 0.6;
    }

    100% {
        opacity: 0;
        transform: scale(8.5, 5);
    }
}

@keyframes ringB {
    0% {
        opacity: 0;
        transform: scale(0.2, 0.25);
    }

    14% {
        opacity: 0.45;
    }

    100% {
        opacity: 0;
        transform: scale(6.5, 4);
    }
}

@keyframes ringC {
    0% {
        opacity: 0;
        transform: scale(0.15, 0.2);
    }

    16% {
        opacity: 0.32;
    }

    100% {
        opacity: 0;
        transform: scale(4.5, 3);
    }
}

/* 注满瞬间倒影亮一次 */
.launch.settled .reflection {
    animation: reflectionPulse 1200ms ease both, reflectionSway 6500ms ease-in-out infinite alternate;
}

@keyframes reflectionPulse {
    0% {
        opacity: 0.55;
    }

    30% {
        opacity: 0.9;
    }

    100% {
        opacity: 0.55;
    }
}

.node {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 10rpx;
    height: 10rpx;
    margin: -5rpx 0 0 -5rpx;
    border-radius: 50%;
    background: #0F8EA8;
    opacity: 0;
}

.launch.settled .node {
    /* 水滴摊开再收拢，不是弹跳 */
    animation: nodeSpread 520ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

@keyframes nodeSpread {
    0% {
        opacity: 0;
        transform: scale(1, 1);
        background: #0F8EA8;
    }

    12% {
        opacity: 1;
    }

    35% {
        transform: scale(1.5, 0.75);
        background: #19A8C6;
    }

    100% {
        opacity: 1;
        transform: scale(1, 1);
        background: #0F8EA8;
    }
}

/* ---------- 文字：大字标悬于线上，水面倒映镜像，文案沉在页脚 ---------- */
.brandZone {
    position: absolute;
    top: 46%;
    right: 0;
    bottom: 0;
    left: 0;
    pointer-events: none;
}

.brand {
    position: absolute;
    right: 0;
    bottom: calc(100% + 96rpx);
    left: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    opacity: 0;
    animation: fadeUp 700ms cubic-bezier(0.22, 0.61, 0.36, 1) 420ms both;
}

.brandCn {
    font-size: 56rpx;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 22rpx;
    text-indent: 22rpx;
    color: #1C2B33;
    font-family: "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
}

.brandEn {
    margin-top: 20rpx;
    font-size: 20rpx;
    font-weight: 500;
    letter-spacing: 12rpx;
    text-indent: 12rpx;
    color: rgba(28, 43, 51, 0.7);
}

/* 水面下的镜像字标：翻转、模糊、随深度消隐，注满时轻晃一次 */
.brandMirror {
    position: absolute;
    top: 4rpx;
    right: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    opacity: 0;
    -webkit-mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.95) 0%, rgba(0, 0, 0, 0) 70%);
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.95) 0%, rgba(0, 0, 0, 0) 70%);
    animation: mirrorIn 900ms ease 1000ms both;
}

@keyframes mirrorIn {
    from {
        opacity: 0;
    }

    to {
        opacity: 1;
    }
}

.mInner {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.mCn,
.mEn {
    transform: scaleY(-1);
}

.mEn {
    font-size: 20rpx;
    font-weight: 500;
    letter-spacing: 12rpx;
    text-indent: 12rpx;
    color: rgba(28, 43, 51, 0.14);
}

.mCn {
    margin-top: 20rpx;
    font-size: 56rpx;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 22rpx;
    text-indent: 22rpx;
    color: rgba(28, 43, 51, 0.2);
    font-family: "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
}

.launch.settled .mCn {
    animation: mirrorRipple 900ms cubic-bezier(0.22, 0.61, 0.36, 1) 120ms both;
}

.launch.settled .mEn {
    animation: mirrorRipple 900ms cubic-bezier(0.22, 0.61, 0.36, 1) 240ms both;
}

@keyframes mirrorRipple {
    0% {
        transform: scaleY(-1) skewX(0);
    }

    40% {
        transform: scaleY(-1.05) skewX(0.8deg);
    }

    100% {
        transform: scaleY(-1) skewX(0);
    }
}

/* 页脚：文案沉底，锚住构图 */
.foot {
    position: absolute;
    right: 0;
    bottom: calc(env(safe-area-inset-bottom) + 64rpx);
    left: 0;
    display: flex;
    justify-content: center;
    opacity: 0;
    animation: fadeIn 600ms ease 700ms both;
}

.tip {
    font-size: 22rpx;
    letter-spacing: 3rpx;
    color: #3D5C68;
    min-height: 32rpx;
    animation: tipIn 380ms ease both;
}

/* 交替 class 使轮换时淡入动画重放 */
.tip.alt {
    animation-name: tipInAlt;
}

@keyframes lineIn {
    from {
        transform: scaleX(0);
    }

    to {
        transform: scaleX(1);
    }
}

@keyframes breathe {
    from {
        opacity: 0.62;
    }

    to {
        opacity: 1;
    }
}

@keyframes glintIn {
    from {
        opacity: 0;
    }

    to {
        opacity: 1;
    }
}

@keyframes glintDrift {
    0% {
        transform: translateX(-220rpx);
        opacity: 0;
    }

    10% {
        opacity: 0.75;
    }

    50% {
        opacity: 0.5;
    }

    90% {
        opacity: 0.75;
    }

    100% {
        transform: translateX(103vw);
        opacity: 0;
    }
}

@keyframes fadeUp {
    from {
        opacity: 0;
        transform: translateY(10rpx);
    }

    to {
        opacity: 1;
        transform: none;
    }
}

@keyframes fadeIn {
    from {
        opacity: 0;
    }

    to {
        opacity: 1;
    }
}

@keyframes tipIn {
    from {
        opacity: 0;
        transform: translateY(6rpx);
    }

    to {
        opacity: 1;
        transform: none;
    }
}

@keyframes tipInAlt {
    from {
        opacity: 0;
        transform: translateY(6rpx);
    }

    to {
        opacity: 1;
        transform: none;
    }
}

@media (prefers-reduced-motion: reduce) {

    .lineWrap {
        animation: none;
        transform: none;
    }

    .line {
        animation: none;
        opacity: 0.8;
    }

    .driftA,
    .driftB {
        animation: none;
        opacity: 1;
    }

    .swell {
        animation: none;
        opacity: 1;
    }

    .caustic {
        animation: none;
        opacity: 1;
    }

    .drop {
        animation: none;
        opacity: 0;
    }

    .glint {
        animation: none;
        opacity: 0;
    }

    .ring {
        animation: none !important;
        opacity: 0;
    }

    .node,
    .launch.settled .node {
        animation: none;
        opacity: 1;
    }

    .reflection,
    .launch.settled .reflection {
        animation: none;
        opacity: 0.5;
    }

    .sheen {
        animation: none;
        opacity: 1;
    }

    .brand,
    .brandMirror,
    .foot {
        animation: none;
        opacity: 1;
    }

    .mCn,
    .mEn,
    .launch.settled .mCn,
    .launch.settled .mEn {
        animation: none;
        transform: scaleY(-1);
    }

    .tip {
        animation: none;
    }

    .launch {
        transition: opacity 300ms ease;
    }
}
