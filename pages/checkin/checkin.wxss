.page {
    min-height: 100vh;
    box-sizing: border-box;
    padding: 28rpx 24rpx calc(env(safe-area-inset-bottom) + 34rpx);
    padding-bottom: calc(constant(safe-area-inset-bottom) + 34rpx);
    position: relative;
    background: linear-gradient(180deg, #f7fcfe 0%, #eef8fb 48%, #f8fbfd 100%);
    overflow: hidden;
}

.bgBlob {
    position: absolute;
    border-radius: 9999rpx;
    pointer-events: none;
}

.b1 {
    width: 520rpx;
    height: 520rpx;
    top: -220rpx;
    right: -180rpx;
    background: radial-gradient(circle at 35% 35%, rgba(61, 205, 221, 0.24), rgba(61, 205, 221, 0));
}

.b2 {
    width: 680rpx;
    height: 680rpx;
    bottom: -360rpx;
    left: -280rpx;
    background: radial-gradient(circle at 68% 30%, rgba(16, 142, 171, 0.12), rgba(16, 142, 171, 0));
}

.b3 {
    width: 420rpx;
    height: 420rpx;
    top: 220rpx;
    left: 520rpx;
    background: radial-gradient(circle at 45% 42%, rgba(63, 207, 224, 0.14), rgba(63, 207, 224, 0));
    opacity: 0.75;
}

.card {
    position: relative;
    z-index: 2;
    background: rgba(255, 255, 255, 0.84);
    border: 1px solid rgba(255, 255, 255, 0.95);
    border-radius: 28rpx;
    box-shadow: 0 24rpx 68rpx rgba(13, 70, 92, 0.10), 0 10rpx 24rpx rgba(13, 70, 92, 0.05), inset 0 1rpx 0 rgba(255, 255, 255, 0.96);
    margin-bottom: 20rpx;
}

.heroCard {
    padding: 24rpx;
}

.heroHead {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.heroTitle {
    font-size: 38rpx;
    font-weight: 800;
    color: #111111;
}

.heroSub {
    display: block;
    margin-top: 8rpx;
    font-size: 24rpx;
    color: rgba(17, 17, 17, 0.52);
}

.goalChip {
    min-width: 180rpx;
    height: 62rpx;
    border-radius: 999rpx;
    padding: 0 22rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24rpx;
    font-weight: 700;
    color: #2f5f95;
    background: rgba(140, 188, 255, 0.26);
    border: 1px solid rgba(140, 188, 255, 0.45);
}

.heroBody {
    margin-top: 22rpx;
}

.heroMain {
    display: flex;
    align-items: baseline;
}

.heroValue {
    font-size: 96rpx;
    line-height: 1;
    font-weight: 800;
    color: #111111;
}

.heroUnit {
    margin-left: 10rpx;
    font-size: 32rpx;
    color: rgba(17, 17, 17, 0.6);
}

.heroHint {
    display: block;
    margin-top: 8rpx;
    margin-bottom: 14rpx;
    font-size: 23rpx;
    color: rgba(17, 17, 17, 0.56);
}

.progressTrack {
    position: relative;
    height: 18rpx;
    border-radius: 999rpx;
    overflow: hidden;
    background: rgba(17, 17, 17, 0.08);
}

.progressFill {
    height: 100%;
    border-radius: 999rpx;
    background: linear-gradient(90deg, #92c3ff 0%, #6ea4f6 55%, #c9ddff 100%);
}

.progressText {
    margin-top: 10rpx;
    font-size: 23rpx;
    color: rgba(17, 17, 17, 0.55);
}

.statsRow {
    margin-top: 18rpx;
    display: flex;
    justify-content: space-between;
    gap: 12rpx;
}

.statItem {
    flex: 1;
    min-width: 0;
    border-radius: 20rpx;
    padding: 14rpx 16rpx;
    background: rgba(255, 255, 255, 0.76);
    border: 1px solid rgba(255, 255, 255, 0.95);
}

.statLabel {
    display: block;
    font-size: 22rpx;
    color: rgba(17, 17, 17, 0.5);
}

.statValue {
    display: block;
    margin-top: 8rpx;
    font-size: 30rpx;
    font-weight: 800;
    color: rgba(17, 17, 17, 0.86);
}

.sectionCard {
    padding: 20rpx;
}

.sectionHead {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.sectionTitle {
    font-size: 32rpx;
    font-weight: 800;
    color: rgba(17, 17, 17, 0.92);
}

.sectionSub {
    font-size: 22rpx;
    color: rgba(17, 17, 17, 0.5);
}

.clearBtn {
    height: 54rpx;
    min-width: 88rpx;
    border-radius: 999rpx;
    padding: 0 18rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 23rpx;
    color: rgba(17, 17, 17, 0.65);
    background: rgba(17, 17, 17, 0.08);
}

.emptyState {
    margin-top: 16rpx;
    border-radius: 20rpx;
    padding: 24rpx 20rpx;
    font-size: 25rpx;
    color: rgba(17, 17, 17, 0.5);
    background: rgba(255, 255, 255, 0.72);
}

.recordList {
    margin-top: 14rpx;
}

.recordItem {
    min-height: 88rpx;
    border-radius: 20rpx;
    background: rgba(255, 255, 255, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.95);
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16rpx 18rpx;
}

.recordItem + .recordItem {
    margin-top: 10rpx;
}

.recordInfo {
    min-width: 0;
    display: flex;
    flex-direction: column;
}

.recordAmount {
    font-size: 30rpx;
    font-weight: 700;
    color: rgba(17, 17, 17, 0.9);
}

.recordTime {
    margin-top: 4rpx;
    font-size: 22rpx;
    color: rgba(17, 17, 17, 0.48);
}

.recordDelete {
    width: 98rpx;
    height: 54rpx;
    border-radius: 999rpx;
    background: rgba(17, 17, 17, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22rpx;
    color: rgba(17, 17, 17, 0.72);
}

.trendRow {
    margin-top: 16rpx;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 8rpx;
}

.trendCol {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.trendWrap {
    width: 52rpx;
    height: 124rpx;
    border-radius: 999rpx;
    background: rgba(17, 17, 17, 0.07);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: hidden;
}

.trendBar {
    width: 100%;
    min-height: 14rpx;
    border-radius: 999rpx;
    background: rgba(138, 186, 255, 0.62);
}

.trendBar.done {
    background: linear-gradient(180deg, #92c3ff 0%, #75abf8 100%);
}

.trendValue {
    margin-top: 8rpx;
    font-size: 22rpx;
    color: rgba(17, 17, 17, 0.68);
}

.trendLabel {
    margin-top: 4rpx;
    font-size: 21rpx;
    color: rgba(17, 17, 17, 0.48);
}

.monthTrendHead {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12rpx;
}

.monthTrendTitleGroup {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
}

.monthTrendSub {
    display: block;
    margin-top: 6rpx;
    font-size: 22rpx;
    color: rgba(17, 17, 17, 0.5);
}

.monthTrendMeta {
    flex-shrink: 0;
    min-width: 122rpx;
    height: 50rpx;
    padding: 0 16rpx;
    border-radius: 999rpx;
    background: rgba(140, 188, 255, 0.18);
    border: 1px solid rgba(140, 188, 255, 0.36);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22rpx;
    font-weight: 700;
    color: #2f5f95;
}

.monthTrendPlot {
    position: relative;
    margin-top: 18rpx;
}

.monthTrendChart {
    position: relative;
    width: 100%;
    border-radius: 24rpx;
    overflow: visible;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.9) 0%, rgba(237, 245, 255, 0.84) 100%);
    border: 1px solid rgba(255, 255, 255, 0.96);
    box-shadow: inset 0 -10rpx 30rpx rgba(110, 164, 246, 0.06);
}

.monthTrendGuide {
    position: absolute;
    left: 0;
    right: 0;
    border-top: 1px dashed rgba(47, 95, 149, 0.14);
}

.monthTrendGoalLine {
    position: absolute;
    left: 0;
    right: 0;
    border-top: 2rpx dashed rgba(47, 95, 149, 0.26);
}

.monthTrendGoalTag {
    position: absolute;
    right: 14rpx;
    top: -28rpx;
    padding: 4rpx 14rpx;
    border-radius: 999rpx;
    font-size: 20rpx;
    color: #2f5f95;
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid rgba(140, 188, 255, 0.32);
}

.monthTrendSegment {
    position: absolute;
    height: 3px;
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(157, 206, 255, 0.92) 0%, rgba(125, 175, 245, 0.9) 100%);
    transform-origin: 0 50%;
    box-shadow: 0 0 10rpx rgba(110, 164, 246, 0.16);
}

.monthTrendSegment.done {
    background: linear-gradient(90deg, #92c3ff 0%, #6ea4f6 100%);
}

.monthTrendPoint {
    position: absolute;
    width: 18rpx;
    height: 18rpx;
    border-radius: 999rpx;
    box-sizing: border-box;
    border: 4rpx solid rgba(125, 175, 245, 0.88);
    background: rgba(255, 255, 255, 0.98);
    box-shadow: 0 4rpx 12rpx rgba(110, 164, 246, 0.2);
    transform: translate(-50%, 50%);
}

.monthTrendPoint.done {
    border-color: #6ea4f6;
    background: #eef5ff;
}

.monthTrendLabels {
    position: relative;
    height: 36rpx;
    margin-top: 12rpx;
}

.monthTrendDate {
    position: absolute;
    top: 0;
    font-size: 20rpx;
    color: rgba(17, 17, 17, 0.48);
    white-space: nowrap;
}

.calendarCard {
    margin-bottom: 0;
}

.calendarHead {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.calendarNav {
    display: flex;
    align-items: center;
    gap: 10rpx;
}

.monthBtn {
    width: 48rpx;
    height: 48rpx;
    border-radius: 999rpx;
    background: rgba(17, 17, 17, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28rpx;
    color: rgba(17, 17, 17, 0.7);
}

.monthText {
    min-width: 168rpx;
    text-align: center;
    font-size: 24rpx;
    font-weight: 700;
    color: rgba(17, 17, 17, 0.78);
}

.monthStats {
    margin-top: 12rpx;
    border-radius: 18rpx;
    padding: 14rpx 16rpx;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8rpx 12rpx;
    background: rgba(255, 255, 255, 0.8);
}

.monthStats wx-text {
    font-size: 22rpx;
    color: rgba(17, 17, 17, 0.62);
}

.weekHeader {
    margin-top: 14rpx;
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    text-align: center;
}

.weekHeader wx-text {
    font-size: 22rpx;
    color: rgba(17, 17, 17, 0.48);
}

.calendarGrid {
    margin-top: 10rpx;
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 8rpx;
}

.dayCell {
    min-height: 86rpx;
    border-radius: 16rpx;
    padding-top: 8rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    background: rgba(255, 255, 255, 0.84);
    border: 1px solid rgba(255, 255, 255, 0.96);
}

.dayCell.out {
    opacity: 0.4;
}

.dayCell.checked {
    border-color: rgba(138, 186, 255, 0.5);
}

.dayCell.completed {
    background: rgba(138, 186, 255, 0.2);
}

.dayCell.today {
    box-shadow: inset 0 0 0 1px rgba(96, 150, 235, 0.7);
}

.dayCell.future {
    opacity: 0.72;
}

.dayNum {
    font-size: 24rpx;
    color: rgba(17, 17, 17, 0.8);
}

.dayMl {
    margin-top: 4rpx;
    font-size: 19rpx;
    color: rgba(17, 17, 17, 0.52);
}

.backNowBtn {
    margin-top: 14rpx;
    height: 68rpx;
    border-radius: 18rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24rpx;
    color: rgba(17, 17, 17, 0.78);
    background: rgba(17, 17, 17, 0.08);
}

.press {
    transform: scale(0.98);
    opacity: 0.92;
}
