<!--
  地图页 · 水杯定位
  设计意图：地图即页面——水杯位置是唯一主角，界面收缩为顶部浮胶囊与底部液态刻度板。
  视觉：全幅真实地图为底，浮层用主题白 #F7F9FA + 浅蓝 #CEECF5 系 + teal #0F8EA8 水线；
        刻度板如量杯内壁——发丝刻度、teal 水位条、墨青 #102A43 文字。
  页面结构：全幅地图（出血到状态栏与四缘）；顶部左「返回+水杯定位」胶囊、右指北复位钮；
        底部液态刻度板：状态行（徽章+摘要+更新时间）、设备切换、定位模式分段、
        水位新鲜度条、附近地标、「回到水杯位置」主按钮；未连接时为涟漪空态 + 「去连接水杯」。
  交互要点：打开即见杯在哪；未连接→知道去哪连；已连接→知道谁在定位（GPS/手机）、数据多新；
        一键回到水杯。
  动效：地图 circles 同心波纹与空态脉冲；「x分钟前更新」新鲜度读数。
-->
<view class="page {{pageAnim}}">
    <map bindregionchange="onRegionChange" circles="{{circles}}" class="map" enable3D="{{false}}" enableBuilding="{{false}}" enableOverlooking="{{false}}" enablePoi="{{false}}" enableRotate="{{true}}" enableSatellite="{{false}}" enableScroll="{{true}}" enableZoom="{{true}}" id="cupMap" latitude="{{latitude}}" longitude="{{longitude}}" markers="{{markers}}" maxScale="20" minScale="4" polyline="{{polylines}}" rotate="{{mapRotate}}" scale="{{scale}}" showLocation="{{false}}" showScale="{{false}}" skew="{{mapSkew}}"></map>

    <view class="topBar fx fx-d1" style="padding-top:{{pageTopPx}}px;">
        <view bindtap="goBack" class="backBtn" hoverClass="press" hoverStayTime="80">
            <view class="backChevron"></view>
        </view>
        <view class="titlePill">
            <text class="titlePillText">水杯定位</text>
        </view>
        <view class="northWrap" wx:if="{{mapRotate > 0.5 && mapRotate < 359.5}}">
            <view bindtap="resetMapNorth" class="northBtn" hoverClass="press" hoverStayTime="80">
                <view class="northNeedle" style="transform:rotate({{mapRotate}}deg);">
                    <view class="needleHead"></view>
                    <view class="needleTail"></view>
                </view>
                <text class="northTxt">北</text>
            </view>
        </view>
    </view>

    <view class="dock fx fx-d2">
        <view class="dockGrab"></view>
        <view class="dockHead">
            <view class="dockHeadLeft">
                <pet-ball wx:if="{{petOn}}" class="dockPet fx-d2" size="dock" page-key="map"/>
                <view class="dockTitleBlock">
                    <text class="dockTitle">定位信息</text>
                    <text class="dockMeta" wx:if="{{cupConnected && trackedDeviceMeta}}">{{trackedDeviceMeta}}</text>
                </view>
            </view>
            <view class="stateLine {{cupConnected ? (cupLatitude !== null ? 'stLive' : 'stWait') : 'stOff'}}">
                <view class="stateDot"></view>
                <text>{{cupConnected ? (cupLatitude !== null ? '在线' : '定位中') : '离线'}}</text>
            </view>
        </view>

        <block wx:if="{{cupConnected}}">
            <view class="statusLine">
                <text class="statusText">{{summaryStatusText}}</text>
                <text class="statusFresh" wx:if="{{freshnessLabel}}">{{freshnessLabel}}</text>
            </view>
            <view class="gauge" wx:if="{{freshnessLabel}}">
                <view class="gaugeTrack">
                    <view class="gaugeFill" style="width:{{freshnessPercent}}%;"></view>
                    <view class="gaugeTick t1"></view>
                    <view class="gaugeTick t2"></view>
                    <view class="gaugeTick t3"></view>
                </view>
                <view class="gaugeScale">
                    <text class="gaugeScaleTxt">3分钟前</text>
                    <text class="gaugeScaleTxt">刚刚</text>
                </view>
            </view>
            <view class="dockGrid">
                <picker bindchange="onTrackedDevicePickerChange" class="dockPicker" disabled="{{!trackedDevicePickerEnabled}}" mode="selector" range="{{trackedDeviceOptions}}" value="{{trackedDeviceIndex}}">
                    <view bindtap="handleTrackedDevicePickerTap" class="devicePill {{trackedDevicePickerEnabled ? '' : 'devicePillOff'}}">
                        <view class="deviceDot"></view>
                        <text class="deviceName">{{trackedDeviceName}}</text>
                        <view class="chevDown"></view>
                    </view>
                </picker>
                <view class="seg" wx:if="{{deviceBleConnected}}">
                    <view bindtap="onLocationModeGps" class="segItem {{locationMode === 'gps' ? 'segOn' : ''}}" hoverClass="press" hoverStayTime="80">
                        <text>GPS</text>
                    </view>
                    <view bindtap="onLocationModePhone" class="segItem {{locationMode === 'phone' ? 'segOn' : ''}}" hoverClass="press" hoverStayTime="80">
                        <text>手机</text>
                    </view>
                </view>
                <view class="modeHint" wx:else>
                    <text>未连蓝牙 · 仅GPS</text>
                </view>
            </view>
            <view class="landmark" wx:if="{{cupAddressDetail || cupAddressLoading}}">
                <text class="landmarkLabel">附近地标</text>
                <text class="landmarkValue {{cupAddressLoading ? 'landmarkLoading' : ''}}">{{cupAddressText}}</text>
            </view>
            <view bindtap="recenter" class="primaryBtn" hoverClass="press" hoverStayTime="80">
                <text class="primaryBtnText">回到水杯位置</text>
            </view>
        </block>

        <block wx:else>
            <view class="emptyState">
                <view class="emptyRipple">
                    <view class="rippleRing r1"></view>
                    <view class="rippleRing r2"></view>
                    <view class="emptyCore"></view>
                </view>
                <view class="emptyCopy">
                    <text class="emptyTitle">还没找到你的水杯</text>
                    <text class="emptySub">连接水杯后，这里会实时显示它所在的位置</text>
                </view>
            </view>
            <view bindtap="goDeviceConnect" class="primaryBtn" hoverClass="press" hoverStayTime="80">
                <text class="primaryBtnText">去连接水杯</text>
            </view>
        </block>

        <view class="dockSafe"></view>
    </view>
</view>
