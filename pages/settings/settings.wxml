<view class="page">
    <view class="header">
        <text class="headerTitle">设置</text>
        <text class="headerSub">自定义你的智能水杯体验</text>
    </view>
    <view class="card">
        <view class="cardHead">
            <view class="icon icon-pencil-dark"></view>
            <view class="cardHeadText">
                <text class="cardTitle">设备重命名</text>
                <text class="cardSub">当前设备：{{lastDeviceName}}</text>
            </view>
        </view>
        <view class="renameRow">
            <input bindinput="onRenameInput" class="renameInput" maxlength="24" placeholder="输入新的设备名称" placeholderClass="renamePlaceholder" type="text" value="{{renameValue}}"></input>
            <view bindtap="saveDeviceName" class="saveBtn" hoverClass="saveBtnHover">
                <text class="saveBtnText">保存</text>
            </view>
        </view>
    </view>
    <view class="card">
        <view class="cardHead">
            <view class="icon icon-cloud-dark"></view>
            <view class="cardHeadText">
                <text class="cardTitle">云端定位设备 ID</text>
                <text class="cardSub">连接蓝牙后会自动从硬件同步，无需手动输入</text>
            </view>
        </view>
        <view class="cloudInfo">
            <text class="cloudStatus">{{cloudStatusText}}</text>
            <text class="cloudId">{{cloudDeviceId?cloudDeviceId:'尚未同步到 IMEI'}}</text>
        </view>
    </view>
    <view class="card">
        <view class="cardHead cardHead--flush">
            <view class="icon icon-smile-dark"></view>
            <view class="cardHeadText">
                <text class="cardTitle">表情伙伴</text>
                <text class="cardSub">关闭后首页、聊天和设备页将不再显示表情球</text>
            </view>
            <switch class="petSwitch" checked="{{petEnabled}}" bindchange="onPetSwitchChange" color="#102a43" aria-label="表情伙伴开关"/>
        </view>
    </view>
    <view bindtap="goPermission" class="card permCard" hoverClass="permCardHover" hoverStayTime="60">
        <view class="cardHead permCardHead">
            <view class="icon icon-key-dark"></view>
            <view class="cardHeadText">
                <text class="cardTitle">权限与连接</text>
                <text class="cardSub">管理蓝牙、位置和通知权限</text>
            </view>
        </view>
        <view class="row-arrow"></view>
    </view>
</view>
