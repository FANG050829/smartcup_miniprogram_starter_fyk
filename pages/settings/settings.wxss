page {
    font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
    -webkit-font-smoothing: antialiased;
    color: #111111;
    background: #FFFFFF;
    letter-spacing: 0.5rpx;
    font-variant-numeric: tabular-nums;
}

.page {
    min-height: 100vh;
    box-sizing: border-box;
    padding: 56rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
    background: #FFFFFF;
}

.header {
    padding: 16rpx 16rpx 40rpx;
}

.headerTitle {
    display: block;
    font-size: 48rpx;
    font-weight: 700;
    color: #111111;
    line-height: 1.1;
    letter-spacing: 1rpx;
}

.headerSub {
    display: block;
    margin-top: 12rpx;
    font-size: 24rpx;
    color: #6b7a85;
    line-height: 1.5;
    letter-spacing: 0.5rpx;
}

.icon {
    width: 36rpx;
    height: 36rpx;
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
    flex-shrink: 0;
}

.icon-pencil-dark {
    background-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%20fill='none'%20stroke='%230d3b4e'%20stroke-width='1.8'%20stroke-linecap='round'%20stroke-linejoin='round'%3E%3Cpath%20d='M12%2020h9'/%3E%3Cpath%20d='M16.5%203.5a2.121%202.121%200%200%201%203%203L7%2019l-4%201%201-4L16.5%203.5z'/%3E%3C/svg%3E");
}

.icon-cloud-dark {
    background-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%20fill='none'%20stroke='%230d3b4e'%20stroke-width='1.8'%20stroke-linecap='round'%20stroke-linejoin='round'%3E%3Cpath%20d='M17.5%2019a4.5%204.5%200%201%200%200-9h-1.8A7%207%200%201%200%204%2015.3'/%3E%3C/svg%3E");
}

.icon-key-dark {
    background-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%20fill='none'%20stroke='%230d3b4e'%20stroke-width='1.8'%20stroke-linecap='round'%20stroke-linejoin='round'%3E%3Cpath%20d='M21%202l-2%202m-7.61%207.61a5.5%205.5%200%201%201-7.778%207.778%205.5%205.5%200%200%201%207.777-7.777zm0%200L15.5%206.5m0%200l3%203L22%206l-3-3'/%3E%3C/svg%3E");
}

.icon-smile-dark {
    background-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%20fill='none'%20stroke='%230d3b4e'%20stroke-width='1.8'%20stroke-linecap='round'%20stroke-linejoin='round'%3E%3Ccircle%20cx='12'%20cy='12'%20r='10'/%3E%3Cpath%20d='M8%2014s1.5%202%204%202%204-2%204-2'/%3E%3Cline%20x1='9'%20x2='9.01'%20y1='9'%20y2='9'/%3E%3Cline%20x1='15'%20x2='15.01'%20y1='9'%20y2='9'/%3E%3C/svg%3E");
}

.cardHead--flush {
    margin-bottom: 0;
}

.petSwitch {
    flex-shrink: 0;
    transform: scale(0.9);
}

.card {
    margin: 0 0 32rpx;
    padding: 36rpx 32rpx;
    background: #FFFFFF;
    border-radius: 44rpx;
    border: 1px solid rgba(255, 255, 255, 0.9);
    box-shadow: 0 24rpx 68rpx rgba(13, 70, 92, 0.12),
    0 12rpx 32rpx rgba(13, 70, 92, 0.08),
    0 4rpx 12rpx rgba(13, 70, 92, 0.04),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.96);
    box-sizing: border-box;
}

.cardHead {
    display: flex;
    align-items: center;
    gap: 20rpx;
    margin-bottom: 28rpx;
}

.cardHeadText {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6rpx;
}

.cardTitle {
    font-size: 32rpx;
    font-weight: 600;
    color: #111111;
    line-height: 1.2;
    letter-spacing: 0.5rpx;
}

.cardSub {
    font-size: 22rpx;
    color: #6b7a85;
    line-height: 1.5;
    letter-spacing: 0.5rpx;
}

.renameRow {
    display: flex;
    gap: 16rpx;
}

.renameInput {
    flex: 1;
    height: 88rpx;
    padding: 0 24rpx;
    background: #FFFFFF;
    border-radius: 24rpx;
    border: 1rpx solid rgba(17, 17, 17, 0.06);
    font-size: 28rpx;
    color: #111111;
    letter-spacing: 0.5rpx;
    box-sizing: border-box;
    transition: border-color 0.2s ease;
}

.renameInput:focus {
    border-color: #0f8ea8;
}

.renamePlaceholder {
    color: #b5bec5;
    letter-spacing: 0.5rpx;
}

.saveBtn {
    flex-shrink: 0;
    min-width: 140rpx;
    height: 88rpx;
    padding: 0 32rpx;
    background: #0f8ea8;
    border-radius: 24rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8rpx 20rpx rgba(15, 142, 168, 0.28);
    transition: transform 0.16s ease, opacity 0.16s ease;
    box-sizing: border-box;
}

.saveBtnHover {
    transform: scale(0.97);
    opacity: 0.92;
}

.saveBtnText {
    font-size: 26rpx;
    color: #FFFFFF;
    font-weight: 600;
    letter-spacing: 2rpx;
}

.cloudInfo {
    padding: 24rpx 28rpx;
    border-radius: 24rpx;
    background: rgba(13, 70, 92, 0.03);
}

.cloudStatus {
    display: block;
    font-size: 22rpx;
    color: #6b7a85;
    letter-spacing: 0.5rpx;
    line-height: 1.4;
}

.cloudId {
    display: block;
    margin-top: 10rpx;
    font-size: 28rpx;
    font-weight: 600;
    color: #111111;
    letter-spacing: 0.5rpx;
    font-variant-numeric: tabular-nums;
    line-height: 1.3;
}

.permCard {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16rpx;
    transition: transform 0.16s ease, opacity 0.16s ease;
}

.permCardHover {
    transform: scale(0.99);
    opacity: 0.92;
}

.permCardHead {
    margin-bottom: 0;
    flex: 1;
}

.row-arrow {
    width: 18rpx;
    height: 18rpx;
    border-top: 2rpx solid #b8c8d0;
    border-right: 2rpx solid #b8c8d0;
    transform: rotate(45deg);
    flex-shrink: 0;
}
