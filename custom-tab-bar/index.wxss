.tabShell {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 999;
    padding-bottom: 0;
    padding-bottom: env(safe-area-inset-bottom);
    padding-bottom: constant(safe-area-inset-bottom);
    background: linear-gradient(180deg, #FFFFFF 0%, #F1F4F6 100%);
    box-shadow: 0 -8px 20px rgba(13, 70, 92, 0.06);
}

.tabBar {
    height: 64px;
    padding: 6px 8px 8px;
    box-sizing: border-box;
    display: flex;
    align-items: stretch;
    border-top: 1px solid rgba(129, 197, 214, 0.22);
}

.tabItem {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    border-radius: 14px;
    transition: transform 0.18s ease, background 0.18s ease;
}

.tabItemHover {
    background: rgba(15, 142, 168, 0.10);
    transform: scale(0.96);
}

.tabItem.active.tabItemHover {
    background: linear-gradient(180deg, rgba(17, 149, 174, 0.18), rgba(17, 149, 174, 0.06));
    transform: scale(0.97);
}

.tabItem.active {
    background: linear-gradient(180deg, rgba(17, 149, 174, 0.10), rgba(17, 149, 174, 0.03));
}

@keyframes tabPulse {
    0% {
        transform: scale(1);
    }

    35% {
        transform: scale(0.92);
    }

    70% {
        transform: scale(1.04);
    }

    100% {
        transform: scale(1);
    }
}

@keyframes iconPulse {
    0% {
        transform: scale(1);
        box-shadow: 0 6px 14px rgba(19, 149, 176, 0.22);
    }

    50% {
        transform: scale(1.12);
        box-shadow: 0 8px 18px rgba(19, 149, 176, 0.36);
    }

    100% {
        transform: scale(1);
        box-shadow: 0 6px 14px rgba(19, 149, 176, 0.22);
    }
}

.tabItem.pulse {
    animation: tabPulse 0.28s ease;
}

.tabItem.pulse .iconPill.active {
    animation: iconPulse 0.28s ease;
}

.iconPill {
    width: 28px;
    height: 28px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(118, 161, 182, 0.14);
    transition: all 0.2s ease;
}

.iconPill.active {
    background: linear-gradient(180deg, #35c4d8, #169cb8);
    box-shadow: 0 6px 14px rgba(19, 149, 176, 0.22);
}

.tabTxt {
    font-size: 10px;
    line-height: 1;
    color: #7b97a8;
}

.tabTxt.active {
    color: #0f8ea8;
    font-weight: 600;
}

.icoWrap {
    position: relative;
    width: 18px;
    height: 18px;
    color: #5f8094;
}

.iconPill.active .icoWrap {
    color: #ffffff;
}

.icoWrap .iconPart {
    position: absolute;
    box-sizing: border-box;
}

.homeRoof {
    left: 2px;
    top: 3px;
    width: 14px;
    height: 14px;
    border-left: 2px solid currentColor;
    border-top: 2px solid currentColor;
    transform: rotate(45deg);
    border-radius: 2px;
}

.homeBody {
    left: 4px;
    top: 8px;
    width: 10px;
    height: 8px;
    border: 2px solid currentColor;
    border-top: none;
    border-radius: 0 0 3px 3px;
}

.homeDoor {
    left: 8px;
    top: 11px;
    width: 2px;
    height: 5px;
    background: currentColor;
    border-radius: 1px;
}

.clockRing {
    left: 2px;
    top: 2px;
    width: 14px;
    height: 14px;
    border: 2px solid currentColor;
    border-radius: 50%;
}

.clockHandHour {
    left: 8px;
    top: 6px;
    width: 2px;
    height: 5px;
    background: currentColor;
    transform-origin: center 4px;
    transform: rotate(20deg);
    border-radius: 1px;
}

.clockHandMin {
    left: 8rpx;
    top: 8rpx;
    width: 5rpx;
    height: 2rpx;
    background: currentColor;
    border-radius: 1rpx;
}

.moodFace {
    left: 0;
    top: 0;
    width: 18px;
    height: 18px;
    border: 2px solid currentColor;
    border-radius: 50%;
}

.moodEye {
    width: 2px;
    height: 3px;
    background: currentColor;
    border-radius: 1px;
    top: 5px;
}

.moodEyeL {
    left: 4px;
}

.moodEyeR {
    right: 4px;
}

.moodSmile {
    left: 4px;
    right: 4px;
    bottom: 3px;
    height: 4px;
    border-bottom: 2px solid currentColor;
    border-radius: 0 0 5px 5px;
}

.mineHead {
    left: 5px;
    top: 2px;
    width: 8px;
    height: 8px;
    border: 2px solid currentColor;
    border-radius: 50%;
}

.mineBody {
    left: 3px;
    top: 11px;
    width: 12px;
    height: 6px;
    border: 2px solid currentColor;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom: none;
}
